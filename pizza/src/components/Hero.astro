---
import { WHATSAPP_NUMBER } from "../data/menu";

const link = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  "Hi Pizza Corner! I'd like to order."
)}`;
---

<section class="hero" id="top">
  <div class="shape" aria-hidden="true">
    <figure class="window arch-mask shutter">
      <img
        src="/assets/chef-oven.jpg"
        alt="The chef slides a pizza into the wood-fired oven with a long peel"
        width="1120"
        height="1260"
      />
    </figure>
  </div>
  <header class="bar frame">
    <a class="wordmark" href="#top">Pizza Corner</a>
    <nav class="links" aria-label="Sections">
      <a href="#menu">Menu</a>
      <a href="#how">How it arrives</a>
      <a href="#order">Order</a>
    </nav>
  </header>
  <div class="lead frame">
    <h1 class="rise">Lit at four.<br />Gone by nine.</h1>
    <p class="support rise" style="--d: 90ms">
      Wood-fired pizzas from a 400 °C oven on Bazaar Street, Chennai. One
      WhatsApp message and it's at your door in thirty minutes.
    </p>
    <a class="arch-btn rise" style="--d: 180ms" href={link}>Order on WhatsApp</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .shape {
    position: absolute;
    width: min(120vh, 78vw);
    height: 128vh;
    right: max(-16vh, -14vw);
    bottom: -14vh;
    background: var(--accent);
    border-radius: var(--arch);
  }
  .window {
    position: absolute;
    inset: 96px 72px 0 72px;
    margin: 0;
  }
  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    flex-wrap: wrap;
  }
  .wordmark {
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: -0.05em;
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 26px;
    font-weight: 600;
    font-size: 1rem;
  }
  .links a {
    color: #f4f4f2;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .links a:hover {
    color: var(--blush);
  }
  .lead {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 26px;
    max-width: 720px;
  }
  h1 {
    font-size: clamp(64px, 6.4vw, 100px);
    letter-spacing: -0.03em;
    line-height: 0.92;
  }
  .support {
    font-size: 1.1875rem;
    max-width: 38ch;
    line-height: 1.45;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 100svh;
    }
    .shape {
      width: 150vw;
      height: 58svh;
      left: 50%;
      right: auto;
      bottom: -14svh;
      transform: translateX(-50%);
    }
    .window {
      inset: 44px 40px 0 40px;
    }
    .lead {
      justify-content: flex-start;
      padding-top: 14svh;
      gap: 20px;
    }
    h1 {
      font-size: 11.5vw;
    }
    .support {
      font-size: 1rem;
      max-width: 34ch;
    }
    .links {
      gap: 16px;
    }
    .links a {
      color: var(--ink);
    }
    .links a:hover {
      color: var(--accent);
    }
  }
</style>
