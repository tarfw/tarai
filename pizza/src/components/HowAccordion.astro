---
import { stages } from "../data/menu";
---

<section class="how frame" id="how">
  <div class="head">
    <h2 class="rise">How it arrives</h2>
    <p class="rise" style="--d: 80ms">
      No app, no account. One message starts your order at the counter; the
      panels below carry it to your gate. Pay by UPI or cash at the door.
    </p>
  </div>
  <div class="row rise" style="--d: 140ms">
    {
      stages.map((s, i) => (
        <button
          class={`acc-panel tint-${i + 1}${i === 1 ? " open" : ""}`}
          type="button"
          data-stage={i}
          aria-expanded={i === 1 ? "true" : "false"}
        >
          <span class="tag">{s.name}</span>
          <span class="panel-body">
            <span class="stage-name">
              {s.name} <span class="when">{s.time}</span>
            </span>
            <span class="stage-text">{s.body}</span>
          </span>
          {s.photo && (
            <span class="pic arch-mask shutter">
              <img
                src={s.photo}
                alt={s.alt}
                width="900"
                height="675"
                loading="lazy"
              />
            </span>
          )}
        </button>
      ))
    }
  </div>
</section>

<style>
  .how {
    padding-block: 130px;
  }
  .head {
    display: grid;
    grid-template-columns: 5fr 1fr 4fr;
    column-gap: 24px;
    align-items: end;
  }
  h2 {
    font-size: clamp(36px, 4vw, 60px);
    grid-column: 1;
  }
  .head p {
    grid-column: 3;
    font-size: 1.125rem;
    line-height: 1.45;
    max-width: 40ch;
  }
  .row {
    margin-top: 64px;
    display: flex;
    height: 520px;
  }
  .acc-panel {
    position: relative;
    flex: 1 1 0%;
    border: none;
    padding: 28px;
    display: block;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    overflow: hidden;
    transition: flex 450ms cubic-bezier(0.6, 0, 0.2, 1);
  }
  .acc-panel.open {
    flex: 5.8 1 0%;
    cursor: default;
  }
  .tint-1 {
    background: var(--tint-1);
    color: var(--olive-ink);
  }
  .tint-2 {
    background: var(--tint-2);
    color: var(--olive-ink);
  }
  .tint-3 {
    background: var(--tint-3);
    color: var(--ink);
  }
  .tint-4 {
    background: var(--tint-4);
    color: var(--ink);
  }
  .tag {
    position: absolute;
    left: 0;
    bottom: 22px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    padding-left: 24px;
  }
  .panel-body {
    display: none;
  }
  .acc-panel.open .tag {
    display: none;
  }
  .acc-panel.open .panel-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .stage-name {
    font-weight: 800;
    font-size: clamp(28px, 2.8vw, 40px);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .when {
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    margin-left: 8px;
    opacity: 0.75;
  }
  .stage-text {
    margin-top: auto;
    max-width: 36ch;
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .pic {
    position: absolute;
    top: 28px;
    right: 28px;
    width: 42%;
    height: 62%;
  }
  .acc-panel:not(.open) .pic {
    display: none;
  }

  @media (max-width: 800px) {
    .how {
      padding-block: 84px;
    }
    .head {
      display: block;
    }
    .head p {
      margin-top: 20px;
      font-size: 1rem;
    }
    .row {
      margin-top: 44px;
      display: block;
      height: auto;
    }
    .acc-panel {
      height: 64px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      overflow: visible;
    }
    .tag {
      position: static;
      writing-mode: horizontal-tb;
      transform: none;
      padding: 0;
      font-size: 1.125rem;
    }
    .acc-panel.open {
      height: auto;
      padding: 24px 20px 28px;
      display: block;
    }
    .acc-panel.open .tag {
      display: block;
      font-size: 1.5rem;
      margin-bottom: 12px;
    }
    .panel-body {
      display: block !important;
    }
    .stage-text {
      margin-top: 12px;
      font-size: 1.0625rem;
    }
    .pic {
      position: static;
      width: 100%;
      height: 220px;
      margin-top: 18px;
      display: block;
    }
    .acc-panel:not(.open) .pic {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    const panel = (e.target as HTMLElement).closest<HTMLElement>(".acc-panel");
    if (!panel || panel.classList.contains("open")) return;
    for (const p of document.querySelectorAll(".acc-panel")) {
      p.classList.toggle("open", p === panel);
      p.setAttribute("aria-expanded", p === panel ? "true" : "false");
    }
    // the newly opened photograph shutters in
    setTimeout(() => panel.querySelector(".shutter")?.classList.add("in"), 80);
  });
</script>
