---
const thumbs = [
  {
    src: "/assets/terracotta-statur-woman-kneading-dough-5th-century.jpg",
    alt: "A terracotta baker kneading dough by hand, 5th century BC",
  },
  {
    src: "/assets/brick-oven.jpg",
    alt: "Flames across the wood-fired oven",
  },
  {
    src: "/assets/diwali-urban-shopping-thiyagaraja-nagar-chennai.jpg",
    alt: "A busy Chennai shopping street",
  },
  {
    src: "/assets/margherita-originale.jpg",
    alt: "A finished margherita on a wooden board",
  },
];
---

<section class="intro frame">
  <p class="statement rise">
    Dough stretched by hand
    <span class="thumb arch-mask" aria-hidden="true"
      ><img src={thumbs[0].src} alt="" width="180" height="120" loading="lazy"
    /></span>
    fired at four hundred degrees
    <span class="thumb arch-mask" aria-hidden="true"
      ><img src={thumbs[1].src} alt="" width="180" height="120" loading="lazy"
    /></span>
    ridden across your neighbourhood
    <span class="thumb arch-mask" aria-hidden="true"
      ><img src={thumbs[2].src} alt="" width="180" height="120" loading="lazy"
    /></span>
    — one WhatsApp message away.
    <span class="thumb arch-mask" aria-hidden="true"
      ><img src={thumbs[3].src} alt="" width="180" height="120" loading="lazy"
    /></span>
  </p>
</section>

<style>
  .intro {
    padding-block: 13vh;
  }
  .statement {
    max-width: 66ch;
    margin: 0 auto;
    text-align: center;
    font-weight: 600;
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .thumb {
    display: inline-block;
    height: 0.95em;
    width: 1.25em;
    vertical-align: -0.14em;
    margin: 0 0.12em;
    background: var(--blush);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .intro {
      padding-block: 96px;
    }
    .statement {
      text-align: left;
      font-size: clamp(22px, 5.6vw, 28px);
      line-height: 1.35;
      max-width: none;
    }
  }
</style>
