---
import { ADDRESS_LINE_1, PHONE_DISPLAY, WHATSAPP_NUMBER } from "../data/menu";

const year = new Date().getFullYear();
const wa = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hi Pizza Corner!")}`;

// The mark, built large: each letter knocked out of its own block,
// bottoms on one line, 4px gaps, blocks differing in height.
type Block = { ch: string; h: number; fill: string; x: number; w: number };
const FILLS = ["var(--sage)", "var(--blush)", "var(--surface)", "var(--sage)"];

function row(word: string, y0: number): Block[] {
  const gap = 6;
  const w = (1000 - gap * (word.length - 1)) / word.length;
  const hs = [0.62, 0.82, 0.72, 0.9, 0.66, 0.86];
  return word.split("").map((ch, i) => ({
    ch,
    h: 200 * hs[i % hs.length],
    fill: FILLS[i % FILLS.length],
    x: i * (w + gap),
    w,
  }));
}
const rows = [
  { blocks: row("PIZZA", 0), y0: 20 },
  { blocks: row("CORNER", 0), y0: 264 },
];

const wa2 = wa;
---

<footer class="foot">
  <div class="frame">
    <div class="mark rise" role="img" aria-label="Pizza Corner">
      {
        rows.map((r) => (
          <svg viewBox="0 0 1000 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            {r.blocks.map((b) => (
              <>
                <rect x={b.x} y={240 - b.h} width={b.w} height={b.h} rx="10" fill={b.fill} />
                <text
                  x={b.x + b.w / 2}
                  y={240 - b.h / 2}
                  text-anchor="middle"
                  dominant-baseline="central"
                  font-size={b.h * 0.56}
                  font-weight="800"
                  letter-spacing="-2"
                  fill="var(--olive)"
                >
                  {b.ch}
                </text>
              </>
            ))}
          </svg>
        ))
      }
    </div>

    <div class="cols rise" style="--d: 100ms">
      <div class="col">
        <h3>Explore</h3>
        <a href="#menu">The menu</a>
        <a href="#how">How it arrives</a>
        <a href="#order">Your order</a>
      </div>
      <div class="col">
        <h3>Order</h3>
        <a href={wa2}>WhatsApp us</a>
        <a href={`tel:${PHONE_DISPLAY.replace(/\s/g, "")}`}>{PHONE_DISPLAY}</a>
      </div>
      <div class="col">
        <h3>Visit</h3>
        <span>{ADDRESS_LINE_1}</span>
        <span>Chennai 600001</span>
        <span>Tue – Sun, 11 am – 10:30 pm</span>
      </div>
      <div class="col note-col">
        <h3>The oven</h3>
        <span>Lit at four daily.</span>
        <span>Mondays, the dough rests.</span>
      </div>
    </div>

    <div class="imprint">
      <p>© {year} Pizza Corner · pizza.tar.site · a TAR sample storefront. Menu, prices and hours are samples to be swapped.</p>
      <p class="credits">
        Pictures: <a href="https://commons.wikimedia.org/w/index.php?curid=94020070">“Commercial Wood Fired Pizza Ovens”</a> by Sahiludiawar, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>, via Wikimedia Commons; <a href="https://commons.wikimedia.org/wiki/File:Margherita_Originale.JPG">“Margherita Originale”</a> by Mario56, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a>, via Wikimedia Commons; <a href="https://commons.wikimedia.org/w/index.php?curid=5260482">“Terracotta statuette of a woman kneading dough, 5th century BC”</a> by MatthiasKabel, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a>, via Wikimedia Commons; <a href="https://commons.wikimedia.org/w/index.php?curid=49593068">“Diwali Urban Shopping, Thiyagaraja Nagar, Chennai”</a> by Arunsarv, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>, via Wikimedia Commons; <a href="https://www.flickr.com/photos/10019047@N05/6152700287">“Brick Oven”</a> by basheertome, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>, via Flickr.
      </p>
      <a class="arch-btn small" href={wa2}>Order on WhatsApp</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--olive);
    color: var(--olive-ink);
    padding-block: 110px 48px;
  }
  .mark svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .mark svg + svg {
    margin-top: 4px;
  }
  .cols {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .col {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
    font-size: 1rem;
  }
  .col h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }
  .col a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .col a:hover {
    color: #ffffff;
  }
  .imprint {
    margin-top: 72px;
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .imprint p {
    font-size: 1rem;
    color: #b9c2ae;
    max-width: 60ch;
  }
  .imprint p a {
    color: #b9c2ae;
  }
  .arch-btn.small {
    margin-top: 8px;
    padding: 14px 24px 16px;
    font-size: 1rem;
    background: var(--blush);
    color: var(--ink);
  }
  .arch-btn.small:hover {
    background: #e3d4c8;
  }

  @media (max-width: 700px) {
    .foot {
      padding-block: 72px 36px;
    }
    .cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
</style>
