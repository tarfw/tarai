---
const stages = [
  { what: "The message: your order lands on WhatsApp", time: "0 min" },
  { what: "The stretch: dough pulled by hand, topped", time: "3 min" },
  { what: "The fire: 400 °C stone, turned twice", time: "4 min" },
  { what: "The ride: boxed, straight out the door", time: "20 min" },
];

// Receipt zigzag for the slip's bottom edge.
const teeth = (() => {
  const n = 18;
  const pts = ["0% 0%", "100% 0%", `100% calc(100% - 14px)`];
  for (let k = n; k >= 0; k--) {
    pts.push(`${((k * 100) / n).toFixed(2)}% ${k % 2 === 0 ? "calc(100% - 14px)" : "100%"}`);
  }
  return `polygon(${pts.join(", ")})`;
})();
---

<section class="how frame" id="how">
  <div class="cols">
    <div class="lead">
      <h2 class="rise">How it arrives</h2>
      <p class="rise" style="--d: 80ms">
        No app, no account. One WhatsApp message starts your order at the
        oven; thirty minutes later a hot box is at your door. Pay by UPI or
        cash when it lands.
      </p>
    </div>
    <div class="slip rise" style={`--d: 140ms; clip-path: ${teeth}`}>
      <h3 class="slip-head">Tonight, from your tap</h3>
      <ul>
        {
          stages.map((s) => (
            <li>
              <span class="what">{s.what}</span>
              <span class="dots" aria-hidden="true" />
              <span class="when">{s.time}</span>
            </li>
          ))
        }
        <li class="final">
          <span>Hot pizza at your door</span>
          <span class="when">30 min</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .how {
    padding-block: 130px 140px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 24px;
    align-items: start;
  }
  .lead {
    grid-column: 1 / 6;
  }
  h2 {
    font-size: var(--head-l);
  }
  .lead p {
    margin-top: 26px;
    max-width: 30ch;
    font-size: 1rem;
  }
  .slip {
    grid-column: 7 / 12;
    color: var(--paper-ink);
    background: var(--surface);
    padding: 34px 34px 48px;
  }
  .slip-head {
    font-family: "Source Serif 4", Georgia, serif;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0;
  }
  ul {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 1rem;
  }
  .what {
    max-width: 24ch;
  }
  .dots {
    flex: 1;
    min-width: 24px;
    height: 5px;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="12" height="5"><circle cx="3" cy="2.5" r="2.2" fill="%236b6763"/></svg>') repeat-x bottom;
    transform: translateY(-4px);
  }
  .when {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .final {
    margin-top: 26px;
    background: var(--accent);
    color: #ffffff;
    padding: 12px 16px;
    font-weight: 600;
    justify-content: space-between;
  }
  .final .when {
    color: inherit;
  }

  @media (max-width: 800px) {
    .how {
      padding-block: 80px 90px;
    }
    .cols {
      display: block;
    }
    h2 {
      font-size: 10.5vw;
    }
    .lead p {
      max-width: none;
    }
    .slip {
      margin-top: 44px;
      padding: 26px 22px 40px;
    }
    li {
      flex-wrap: wrap;
    }
    .what {
      max-width: none;
    }
  }
</style>
