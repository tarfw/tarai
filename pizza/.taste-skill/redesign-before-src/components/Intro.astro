---
const facts = [
  { big: "400 °C", note: "the stone, by six" },
  { big: "30 min", note: "tap to door" },
  { big: "2 km", note: "our whole radius" },
  { big: "₹149", note: "margherita, GST extra" },
];
---

<section class="intro frame">
  <div class="cols">
    <h2 class="rise">The oven decides</h2>
    <p class="note rise" style="--d: 80ms">
      The fire is lit at four. By six the stone holds four hundred degrees
      and the first dough of the evening goes in. Nothing here is
      conveyor-baked.
    </p>
    <div class="facts" role="list">
      {
        facts.map((f, i) => (
          <div class="fact rise" style={`--d: ${i * 80}ms`} role="listitem">
            <p class="big">{f.big}</p>
            <p class="note-line">{f.note}</p>
          </div>
        ))
      }
    </div>
    <figure class="pic rise" style="--d: 160ms">
      <img
        src="/assets/terracotta-statur-woman-kneading-dough-5th-century.jpg"
        alt="A terracotta statuette of a baker leaning over a basin, kneading dough by hand"
        width="900"
        height="675"
        loading="lazy"
      />
      <figcaption>
        A baker kneads dough by hand. Terracotta, Greece, 5th century BC.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .intro {
    padding-block: 120px 100px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 20px;
  }
  h2 {
    grid-column: 1 / 7;
    font-size: var(--head-xl);
    max-width: 6ch;
  }
  .note {
    grid-column: 10 / 13;
    align-self: end;
    max-width: 260px;
    font-size: 1rem;
    line-height: 1.5;
  }
  .facts {
    grid-column: 1 / 13;
    margin-top: 110px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .fact {
    min-width: 130px;
  }
  .big {
    font-size: var(--fact);
    line-height: 1.05;
    font-weight: 400;
  }
  .note-line {
    margin-top: 6px;
    font-size: var(--step-small);
    color: var(--muted);
  }
  .pic {
    grid-column: 8 / 13;
    margin: 64px 0 0;
  }
  .pic img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius);
  }
  .pic figcaption {
    margin-top: 10px;
    font-size: var(--step-small);
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .intro {
      padding-block: 72px 56px;
    }
    .cols {
      display: block;
    }
    h2 {
      font-size: 11vw;
      max-width: none;
    }
    .note {
      margin-top: 18px;
      max-width: none;
    }
    .facts {
      margin-top: 56px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px 16px;
    }
    .big {
      font-size: 26px;
    }
    .pic {
      margin-top: 48px;
    }
  }
</style>
