---
import { WHATSAPP_NUMBER } from "../data/menu";

const link = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  "Hi Pizza Corner! I'd like to order."
)}`;
---

<section class="hero frame">
  <div class="card">
    <div class="stripe" aria-hidden="true">
      {Array.from({ length: 24 }).map(() => <span></span>)}
    </div>
    <div class="card-body">
      <h1 class="rise">Pizza Corner</h1>
      <p class="couplet rise" style="--d: 70ms">
        Lit at four. Eaten by nine.
      </p>
      <p class="support rise" style="--d: 140ms">
        Wood-fired pizzas on Bazaar Street, Chennai. Order on WhatsApp and
        it's at your door in thirty minutes.
      </p>
      <a class="btn rise" style="--d: 210ms" href={link}>Order on WhatsApp</a>
    </div>
    <nav class="card-links rise" style="--d: 280ms" aria-label="Sections">
      <a href="#menu">The menu</a>
      <a href="#how">How it arrives</a>
      <a href="#visit">Visit us</a>
    </nav>
  </div>

  <figure class="room">
    <div class="xfade" aria-label="Photographs of the wood-fired oven at work">
      <img
        class="on"
        src="/assets/chef-oven.jpg"
        alt="The chef slides a pizza into the wood-fired oven with a long peel"
        width="1120"
        height="1260"
      />
      <img
        src="/assets/brick-oven.jpg"
        alt="Two pizzas bake on the stone floor as flames leap across the oven"
        width="1024"
        height="683"
        loading="lazy"
      />
      <img
        src="/assets/margherita-originale.jpg"
        alt="A finished margherita with a blistered crust on a wooden board"
        width="1920"
        height="1440"
        loading="lazy"
      />
    </div>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-top: 12px;
    min-height: 100svh;
  }

  .card {
    display: flex;
    flex-direction: column;
    color: var(--paper-ink);
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 12px;
  }
  .stripe {
    border-radius: 0;
    flex: 0 0 auto;
  }
  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 32px 24px;
    gap: 22px;
  }
  h1 {
    font-family: "Libre Franklin", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: var(--display);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .couplet {
    font-family: "Source Serif 4", Georgia, serif;
    font-style: italic;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    margin-top: 4px;
  }
  .support {
    max-width: 36ch;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .card-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 32px;
    padding: 0 24px 26px;
    font-family: "Libre Franklin", "Helvetica Neue", sans-serif;
    font-size: 1rem;
  }
  .card-links a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .card-links a:hover {
    color: var(--accent);
  }

  .room {
    margin: 0 0 12px 0;
    height: calc(100svh - 24px);
  }
  .xfade {
    position: sticky;
    top: 12px;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .xfade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.6s ease, transform 6.4s linear;
  }
  .xfade img.on {
    opacity: 1;
    transform: scale(1.05);
  }

  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 12px;
    }
    .room {
      order: -1;
      height: 48svh;
    }
    .xfade img {
      object-position: 50% 20%;
    }
    .xfade {
      position: static;
    }
    .card {
      margin-top: -24px;
      position: relative;
      z-index: 1;
    }
    .stripe {
      height: 40px;
    }
    .card-body {
      padding: 36px 22px 18px;
      gap: 18px;
    }
    h1 {
      font-size: 11vw;
    }
    .couplet {
      font-size: 23px;
    }
    .support {
      font-size: 1rem;
    }
    .card-links {
      padding-bottom: 22px;
    }
  }
</style>
