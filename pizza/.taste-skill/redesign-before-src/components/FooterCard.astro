---
import { ADDRESS_LINE_1, ADDRESS_LINE_2, PHONE_DISPLAY, WHATSAPP_NUMBER } from "../data/menu";

const year = new Date().getFullYear();

// Twelve semicircular scallops across the panel's top edge.
const scallops = (() => {
  const n = 12;
  const w = 1200 / n;
  let d = `M0,50`;
  for (let i = 0; i < n; i++) d += ` A ${w / 2},50 0 0 1 ${w * (i + 1)},50`;
  return d + " Z";
})();

const wa = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  "Hi Pizza Corner!"
)}`;
---

<footer class="foot">
  <div class="stripe-thin frame" aria-hidden="true">
    {Array.from({ length: 60 }).map(() => <span></span>)}
  </div>
  <div class="ground frame">
    <svg class="scallops" viewBox="0 0 1200 50" preserveAspectRatio="none" aria-hidden="true">
      <path d={scallops} fill="var(--surface)" />
    </svg>
    <div class="panel">
      <div class="half message">
        <h2 class="rise">Come hungry.</h2>
        <p class="rise" style="--d: 80ms">
          The fire is lit at four, every day but Monday. Bring the family;
          the corner table seats eight.
        </p>
      </div>
      <div class="half block rise" style="--d: 140ms">
        <img
          class="stamp"
          src="/assets/margherita-originale.jpg"
          alt="A margherita fresh from the oven"
          width="88"
          height="117"
          loading="lazy"
        />
        <a class="line" href={wa}>WhatsApp {PHONE_DISPLAY}</a>
        <a class="line" href={`tel:${PHONE_DISPLAY.replace(/\s/g, "")}`}>{PHONE_DISPLAY}</a>
        <a
          class="line"
          href="https://maps.google.com/?q=Bazaar+Street+Chennai"
          target="_blank"
          rel="noopener"
        >
          {ADDRESS_LINE_1}, Chennai
        </a>
        <span class="line muted-line">{ADDRESS_LINE_2}</span>
      </div>
    </div>
  </div>
  <div class="imprint frame">
    <p>
      © {year} Pizza Corner · pizza.tar.site · a TAR sample storefront.
      Menu, prices and hours are samples to be swapped.
    </p>
    <p class="credits">
      Pictures: <a href="https://commons.wikimedia.org/w/index.php?curid=94020070">“Commercial Wood Fired Pizza Ovens”</a> by Sahiludiawar, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>, via Wikimedia Commons; <a href="https://commons.wikimedia.org/wiki/File:Margherita_Originale.JPG">“Margherita Originale”</a> by Mario56, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a>, via Wikimedia Commons; <a href="https://commons.wikimedia.org/w/index.php?curid=5260482">“Terracotta statuette of a woman kneading dough, 5th century BC”</a> by MatthiasKabel, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a>, via Wikimedia Commons; <a href="https://commons.wikimedia.org/w/index.php?curid=49593068">“Diwali Urban Shopping, Thiyagaraja Nagar, Chennai”</a> by Arunsarv, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>, via Wikimedia Commons; <a href="https://www.flickr.com/photos/10019047@N05/6152700287">“Brick Oven”</a> by basheertome, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>, via Flickr.
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--field-1);
    padding-top: 8px;
  }
  .stripe-thin {
    max-width: none;
    margin-bottom: 56px;
  }
  .stripe-thin span {
    flex: 1 1 auto;
  }
  .ground {
    padding-block: 0 64px;
  }
  .scallops {
    display: block;
    width: 100%;
    height: 40px;
  }
  .panel {
    color: var(--paper-ink);
    background: var(--surface);
    margin: 0 auto;
    max-width: calc(1200px - 2 * var(--margin));
    width: 100%;
    min-height: 420px;
    padding: 64px 64px 48px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
  }
  .message h2 {
    font-size: 2rem;
  }
  .message p {
    margin-top: 18px;
    max-width: 34ch;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .block {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
    position: relative;
    padding-top: 8px;
  }
  .stamp {
    position: absolute;
    top: 0;
    right: 0;
    width: 88px;
    height: 117px;
    object-fit: cover;
    padding: 6px;
    background: #ffffff;
  }
  .line {
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .line:hover {
    color: var(--accent);
  }
  .muted-line {
    color: var(--paper-muted);
    text-decoration: none;
  }
  .imprint {
    padding-top: 28px;
    padding-bottom: 36px;
    text-align: center;
    display: grid;
    gap: 10px;
  }
  .imprint p {
    font-size: var(--step-small);
    color: #c3cdd4;
    max-width: 72ch;
    margin: 0 auto;
  }
  .imprint a {
    color: #c3cdd4;
  }

  @media (max-width: 700px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 44px 28px 36px;
      min-height: 0;
      gap: 32px;
    }
    .stamp {
      width: 64px;
      height: 85px;
    }
    .line {
      font-size: 1.0625rem;
    }
  }
</style>
