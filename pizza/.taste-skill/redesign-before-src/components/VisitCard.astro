---
import {
  ADDRESS_LINE_1,
  ADDRESS_LINE_2,
  PHONE_DISPLAY,
  WHATSAPP_NUMBER,
} from "../data/menu";

const link = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  "Hi Pizza Corner! I'd like to order."
)}`;
---

<section class="visit" id="visit">
  <img
    class="street"
    src="/assets/diwali-urban-shopping-thiyagaraja-nagar-chennai.jpg"
    alt="A busy Chennai shopping street under the midday sun, storefronts and crowds"
    width="1920"
    height="1080"
    loading="lazy"
  />
  <div class="card rise">
    <h2>Visit us</h2>
    <p class="addr">
      {ADDRESS_LINE_1}<br />
      {ADDRESS_LINE_2}
    </p>
    <dl class="hours">
      <div>
        <dt>Tue – Sun</dt>
        <dd>11 am – 10:30 pm</dd>
      </div>
      <div>
        <dt>Monday</dt>
        <dd>closed</dd>
      </div>
    </dl>
    <p class="phone">{PHONE_DISPLAY}</p>
    <a class="btn book" href={link}>WhatsApp us</a>
  </div>
</section>

<style>
  .visit {
    position: relative;
    min-height: 100svh;
  }
  .street {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .card {
    position: absolute;
    top: 60px;
    right: 60px;
    width: 380px;
    color: var(--paper-ink);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 32px;
  }
  h2 {
    font-size: 1.75rem;
  }
  .addr {
    margin-top: 14px;
    font-size: 1rem;
    line-height: 1.5;
  }
  .hours {
    margin: 20px 0 0;
    display: grid;
    gap: 8px;
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    font-size: 1rem;
  }
  .hours dt {
    color: var(--paper-muted);
  }
  .hours dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .phone {
    margin-top: 20px;
    font-size: 1rem;
  }
  .book {
    width: 100%;
    margin-top: 22px;
    padding: 16px 0;
  }

  @media (max-width: 700px) {
    .visit {
      min-height: 0;
    }
    .street {
      position: static;
      height: 70svh;
    }
    .card {
      position: relative;
      top: 0;
      right: 0;
      width: auto;
      margin: -80px 16px 0;
    }
  }
</style>
