{
  "expo": {
    "name": "tar",
    "slug": "tar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tarlogo.png",
    "scheme": "tar",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "visible": "always",
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/images/tarlogo.png",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tarfw.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/tarlogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.INTERNET"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 120
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.226183831843-5sjvl1hsv4d04aucnqsqn19u83o4f5ku",
          "webClientId": "226183831843-5sjvl1hsv4d04aucnqsqn19u83o4f5ku.apps.googleusercontent.com",
          "scopes": [
            "profile",
            "email"
          ]
        }
      ],
      "expo-secure-store",
      "expo-file-system",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TAR to access your photos to select product and brand images.",
          "cameraPermission": "Allow TAR to access your camera to capture product photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "efb1d63a-cd61-4d36-8906-a2fefc57b4f8"
      }
    },
    "owner": "tarteam01"
  }
}
