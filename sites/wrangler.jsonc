{
  "$schema": "../tarharness/node_modules/wrangler/config-schema.json",
  "name": "tar-sites",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "vars": { "HARNESS_ORIGIN": "https://tarharness.tar-54d.workers.dev" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{ "binding": "CONTROL", "database_name": "tarharness-control", "database_id": "b95baf00-39d7-41d7-847a-8d8658165882" }],
  "r2_buckets": [{ "binding": "SITE_RELEASES", "bucket_name": "tar-site-releases" }]
}
