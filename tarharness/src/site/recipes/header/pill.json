{
  "id": "pill",
  "type": "header",
  "models": ["products", "food", "booking", "quote", "digital", "bulk"],
  "needs": { "brand": "required" },
  "layout": { "kind": "row" },
  "slots": {
    "brand": { "source": "facts.name", "max": 40 }
  },
  "tokens": {
    "text": "color.ink",
    "background": "color.surface",
    "accent": "color.accent",
    "radius": "shape.pill",
    "shadow": "elevation.low"
  },
  "settings": {
    "links": { "type": "boolean", "default": true }
  },
  "fallback": { "brand": "Your store name" },
  "source": {
    "pattern": "a rounded bar holding the name and one menu button, floating above the page",
    "reference": "structural pattern only; no copy, colour or asset came from anywhere"
  }
}
