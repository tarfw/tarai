{
  "id": "banner",
  "type": "spotlight",
  "models": ["products", "food", "digital", "bulk"],
  "needs": {
    "item": "required",
    "media": "optional",
    "cta": "optional"
  },
  "layout": { "kind": "split", "ratio": "2/1", "collapse": "stack" },
  "slots": {
    "item": { "source": "items[0]" },
    "media": { "source": "photos[0]" },
    "cta": { "source": "route.primary" }
  },
  "tokens": {
    "text": "color.ink",
    "background": "color.surface",
    "accent": "color.accent",
    "radius": "shape.lg"
  },
  "settings": {
    "label": { "type": "text", "default": "See it", "max": 30 }
  },
  "fallback": { "cta": "#catalog" },
  "source": {
    "pattern": "one offer wide beside its photo and one action",
    "reference": "structural pattern only; no copy, colour or asset came from anywhere"
  }
}
