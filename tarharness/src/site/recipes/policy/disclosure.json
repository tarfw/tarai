    "border": "color.border"
  },
  "settings": {
    "open": { "type": "boolean", "default": false }
  },
  "fallback": {},
  "source": {
    "pattern": "each term on its own expandable line under one heading",
    "reference": "structural pattern only; no copy, colour or asset came from anywhere"
  }
}
