{
  "id": "disclosure",
  "type": "policy",
  "models": ["products", "digital", "bulk"],
  "needs": { "terms": "required" },
  "layout": { "kind": "disclosure" },
  "slots": {
    "terms": { "source": "facts.terms", "count": 8 }
  },
  "tokens": {
    "text": "color.ink",
    "background": "color.surface",
