{
  "id": "card",
  "type": "footer",
  "models": ["products", "food", "booking", "quote", "digital", "bulk"],
  "needs": {
    "brand": "required",
    "body": "optional",
    "points": "optional"
  },
  "layout": { "kind": "row" },
  "slots": {
    "brand": { "source": "facts.name", "max": 40 },
    "body": { "source": "brief.goal", "max": 160 },
    "points": { "source": "facts.hours", "count": 4 }
  },
  "tokens": {
    "text": "color.canvas",
    "background": "color.ink",
    "muted": "color.muted",
    "border": "color.border"
  },
  "settings": {
    "links": { "type": "boolean", "default": true }
  },
  "fallback": { "brand": "Your store name" },
  "source": {
    "pattern": "a card of contact details beside page links, closing the document",
    "reference": "structural pattern only; no copy, colour or asset came from anywhere"
  }
}
