{
  "id": "split",
  "type": "hero",
  "models": ["products", "food", "booking", "quote", "digital", "bulk"],
  "needs": {
    "headline": "required",
    "body": "optional",
    "media": "optional",
    "cta": "optional"
  },
  "layout": { "kind": "split", "ratio": "50/50", "collapse": "stack" },
  "slots": {
    "headline": { "source": "facts.name", "max": 60 },
    "body": { "source": "brief.goal", "max": 220 },
    "media": { "source": "photos[0]" },
    "cta": { "source": "route.primary" }
  },
  "tokens": {
    "text": "color.ink",
    "background": "color.canvas",
    "accent": "color.accent",
    "surface": "color.surface",
    "radius": "shape.lg"
  },
  "settings": {
    "eyebrow": { "type": "text", "default": "Now open", "max": 40 },
    "label": { "type": "text", "default": "See the shop", "max": 30 },
    "reverse": { "type": "boolean", "default": false }
  },
  "fallback": {
    "headline": "Your store name",
    "cta": "#catalog"
  },
  "source": {
    "pattern": "name and one line beside one large photo, stacked on a narrow screen",
    "reference": "structural pattern only; no copy, colour, photo or font came from anywhere"
  }
}
