{
  "id": "fullscreen",
  "type": "hero",
  "models": ["products", "food", "booking", "quote", "digital", "bulk"],
  "needs": {
    "headline": "required",
    "body": "optional",
    "media": "optional",
    "cta": "optional"
  },
  "layout": { "kind": "overlay", "height": "full", "scrim": "color.ink" },
  "slots": {
    "headline": { "source": "facts.name", "max": 60 },
    "body": { "source": "brief.goal", "max": 220 },
    "media": { "source": "photos[0]" },
    "cta": { "source": "route.primary" }
  },
  "tokens": {
    "text": "color.canvas",
    "background": "color.ink",
    "accent": "color.accent",
    "radius": "shape.pill",
    "display": "type.display"
  },
  "settings": {
    "label": { "type": "text", "default": "See the shop", "max": 30 }
  },
  "fallback": {
    "headline": "Your store name",
    "cta": "#catalog"
  },
  "source": {
    "pattern": "one photo behind the name, one line and one action, centred near the bottom",
    "reference": "structural pattern only; no copy, colour, photo or font came from anywhere"
  }
}
