{
  "id": "fullscreen",
  "type": "hero",
  "models": ["products", "food", "booking", "quote", "digital", "bulk"],
  "needs": { "media": "optional" },
  "layout": { "kind": "overlay", "height": "viewport", "align": "bottom", "collapse": "stack" },
  "slots": {
    "headline": { "source": "brief.headline", "max": 80 },
    "body":     { "source": "brief.summary", "max": 200 },
    "media":    { "source": "photos[0]", "optional": true },
    "cta":      { "source": "route.primary", "label": "text" },
    "points":   { "source": "brief.points", "max": 3, "optional": true }
  },
  "tokens": {
    "scrim":   "color.ink",
    "text":    "color.paper",
    "accent":  "color.accent",
    "radius":  "shape.md",
    "display": "type.display",
    "body":    "type.body"
  },
  "settings": {
    "scrimStrength": { "type": "choice", "options": ["light", "medium", "strong"], "default": "medium" },
    "ctaLabel":      { "type": "text", "default": "View collection" },
    "showPoints":    { "type": "boolean", "default": true }
  },
  "fallback": {
    "media": "token:color.surface",
    "headline": "Your store name"
  },
  "source": {
    "pattern": "full-screen hero with overlay text and a row of short points",
    "reference": "structural description only; no copy, colors or assets taken"
  }
}
