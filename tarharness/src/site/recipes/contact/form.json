{
  "id": "form",
  "type": "contact",
  "models": ["products", "food", "booking", "quote", "digital", "bulk"],
  "needs": {
    "email": "optional",
    "phone": "optional"
  },
  "layout": { "kind": "stack" },
  "slots": {
    "email": { "source": "facts.email" },
    "phone": { "source": "facts.phone" }
  },
  "tokens": {
    "text": "color.ink",
    "background": "color.surface",
    "border": "color.border",
    "accent": "color.accent",
    "radius": "shape.md"
  },
  "settings": {
    "label": { "type": "text", "default": "Send", "max": 30 }
  },
  "fallback": {},
  "source": {
    "pattern": "a short enquiry form over a plain card, one field per line",
    "reference": "structural pattern only; no copy, colour or asset came from anywhere"
  }
}
