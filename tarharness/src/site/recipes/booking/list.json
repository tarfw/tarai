{
  "id": "list",
  "type": "booking",
  "models": ["booking", "quote"],
  "needs": {
    "services": "required",
    "cta": "optional"
  },
  "layout": { "kind": "stack" },
  "slots": {
    "services": { "source": "services[0..11]", "count": 12 },
    "cta": { "source": "route.contact" }
  },
  "tokens": {
    "text": "color.ink",
    "background": "color.canvas",
    "accent": "color.accent",
    "border": "color.border",
    "radius": "shape.md"
  },
  "settings": {
    "label": { "type": "text", "default": "Ask about this", "max": 30 }
  },
  "fallback": { "cta": "/contact" },
  "source": {
    "pattern": "one service per row with its price and one way to ask",
    "reference": "structural pattern only; no copy, colour or asset came from anywhere"
  }
}
