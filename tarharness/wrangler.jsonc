{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarharness",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OIDC_ISSUER": "https://accounts.google.com,accounts.google.com",
    "OIDC_AUDIENCE": "226183831843-5sjvl1hsv4d04aucnqsqn19u83o4f5ku.apps.googleusercontent.com",
    "OIDC_JWKS_URL": "https://www.googleapis.com/oauth2/v3/certs",
    "TURSO_ORG": "tarapp",
    "TURSO_GROUP": "default",
    "SITE_WORKER_ORIGIN": "https://tar-sites.tar-54d.workers.dev",
    "GROQ_MODEL": "qwen/qwen3.8-27b"
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "tarharness-control",
      "database_id": "548127bc-c645-441b-9fc1-1c79d357b4f8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "r2_buckets": [
    { "binding": "PRODUCT_CONTENT", "bucket_name": "tar-product-content" },
    { "binding": "SITE_RELEASES", "bucket_name": "tar-site-releases" }
  ],
  "ai": { "binding": "AI" }
}
