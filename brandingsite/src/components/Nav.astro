---
// Clean Transparent Header Navigation in Canopy Green
import TarLogo from "./TarLogo.astro";
---

<header class="clean-nav-header">
  <div class="container nav-inner">
    
    <!-- Left: Brand Logo -->
    <a href="/" class="nav-logo" aria-label="TAR Homepage">
      <TarLogo size={26} color="#55dd4a" />
      <span class="logo-text font-dm-sans">tar.</span>
    </a>

    <!-- Center/Right: Clean Efficient Menu Links -->
    <nav class="nav-menu" aria-label="Main Navigation">
      <a href="/manifesto" class="nav-link">Manifesto</a>
      <a href="/#capabilities" class="nav-link">Capabilities</a>
      <a href="/agents" class="nav-link">Agents</a>
      <a href="/learn" class="nav-link">Learn</a>
      <a href="/#pricing" class="nav-link">Pricing</a>
      <a href="/docs" class="nav-link nav-link-docs">Docs</a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Navigation">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <div class="container mobile-drawer-inner">
      <a href="/manifesto" class="mobile-link">Manifesto</a>
      <a href="/#capabilities" class="mobile-link">Capabilities</a>
      <a href="/agents" class="mobile-link">Agents & Rates</a>
      <a href="/learn" class="mobile-link">Learn (Guides)</a>
      <a href="/#pricing" class="mobile-link">Pricing</a>
      <a href="/docs" class="mobile-link">Documentation</a>
    </div>
  </div>
</header>

<script>
  const initNav = () => {
    const btn = document.getElementById('mobileMenuBtn');
    const drawer = document.getElementById('mobileNavDrawer');
    if (!btn || !drawer) return;

    btn.addEventListener('click', () => {
      drawer.classList.toggle('open');
      btn.classList.toggle('active');
    });

    const links = drawer.querySelectorAll('.mobile-link');
    links.forEach(l => l.addEventListener('click', () => {
      drawer.classList.remove('open');
      btn.classList.remove('active');
    }));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>

<style>
  .clean-nav-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-canopy-green);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: 68px;
    display: flex;
    align-items: center;
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon {
    color: #55dd4a;
  }

  .logo-text {
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .nav-menu {
    display: none;
    align-items: center;
    gap: 4px;
  }

  @media (min-width: 860px) {
    .nav-menu {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-dm-sans);
    font-size: 14.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    padding: 6px 10px;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link-docs {
    color: var(--color-leaf-bright);
    font-weight: 600;
  }

  .nav-link-docs:hover {
    color: #ffffff;
  }

  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 860px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .bar {
    width: 20px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-menu-btn.active .bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-menu-btn.active .bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-nav-drawer {
    display: none;
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    background-color: var(--color-canopy-green);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 24px 0;
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-link {
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
</style>