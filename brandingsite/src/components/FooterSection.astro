---
// Vellum-style dark footer: GET STARTED pill, bee mascot peeking over the
// divider, four link columns, minimal bottom bar.
const productLinks = [
  { name: "Product", href: "/#capabilities" },
  { name: "Channels", href: "/#channels" },
  { name: "Pricing", href: "/#pricing" }
];

const resourcesLinks = [
  { name: "Docs", href: "/docs" },
  { name: "Learn", href: "/learn" }
];

const companyLinks = [
  { name: "Manifesto", href: "/manifesto" },
  { name: "Support", href: "/support" },
  { name: "Community", href: "/guidelines" }
];

const legalLinks = [
  { name: "Privacy", href: "/privacy" },
  { name: "Terms", href: "/terms" }
];
---

<footer class="footer-section">
  <div class="container footer-container font-dm-sans">

    <!-- GET STARTED -->
    <div class="cta-row">
      <a href="https://play.google.com/store/apps" class="get-started-btn">GET STARTED</a>
    </div>

    <!-- Story caption -->
    <p class="bee-story font-dm-sans">
      A small swarm, hard at work — a scout up high, two workers among the
      flowers, every order and reply picked up on the way.
    </p>

    <!-- Bee environment: night meadow, flowers, three mascot bees -->
    <div class="bee-scene" aria-hidden="true">

      <!-- pixel flowers -->
      <div class="flower f1">
        <svg viewBox="0 0 8 18" width="32" height="72">
          <rect x="3" y="6" width="1.4" height="12" fill="#3c7a4a" />
          <rect x="1" y="10" width="2" height="1" fill="#3c7a4a" />
          <rect x="5" y="13" width="2" height="1" fill="#3c7a4a" />
          <rect x="2.6" y="0" width="2.8" height="2.8" fill="#ffcf3f" />
          <rect x="0" y="2.6" width="8" height="2.8" fill="#ffcf3f" />
          <rect x="2.6" y="5.2" width="2.8" height="2.8" fill="#ffcf3f" />
          <rect x="3.3" y="3.3" width="1.4" height="1.4" fill="#b5772a" />
        </svg>
      </div>
      <div class="flower f2">
        <svg viewBox="0 0 8 18" width="26" height="58">
          <rect x="3" y="6" width="1.4" height="12" fill="#3c7a4a" />
          <rect x="5" y="11" width="2" height="1" fill="#3c7a4a" />
          <rect x="2.6" y="0" width="2.8" height="2.8" fill="#ff7bac" />
          <rect x="0" y="2.6" width="8" height="2.8" fill="#ff7bac" />
          <rect x="2.6" y="5.2" width="2.8" height="2.8" fill="#ff7bac" />
          <rect x="3.3" y="3.3" width="1.4" height="1.4" fill="#ffffff" />
        </svg>
      </div>
      <div class="flower f3">
        <svg viewBox="0 0 8 18" width="24" height="54">
          <rect x="3" y="6" width="1.4" height="12" fill="#3c7a4a" />
          <rect x="1" y="9" width="2" height="1" fill="#3c7a4a" />
          <rect x="2.6" y="0" width="2.8" height="2.8" fill="#55dd4a" />
          <rect x="0" y="2.6" width="8" height="2.8" fill="#55dd4a" />
          <rect x="2.6" y="5.2" width="2.8" height="2.8" fill="#55dd4a" />
          <rect x="3.3" y="3.3" width="1.4" height="1.4" fill="#b5772a" />
        </svg>
      </div>

      <!-- Bee 1: the scout — patrols the left edge, high and alert -->
      <div class="bee bee-1 role-worker-1">
        <svg viewBox="0 -0.9 7 8" width="54" height="62">
          <g class="bee-wings">
            <rect x="1.1" y="-0.75" width="2" height="0.7" fill="#dff1ff" />
            <rect x="3.9" y="-0.75" width="2" height="0.7" fill="#dff1ff" />
          </g>
          <path class="bee-body" fill="#ffcf3f" d="M0 0 H2 V1 H5 V0 H7 V1 H6 V2 H7 V6.75 H6 V6.2 H4 V7.1 H3 V6.2 H1 V6.75 H0 V2 H1 V1 H0 Z" />
          <g class="bee-eyes">
            <rect x="1.4" y="3.15" width="0.7" height="0.7" fill="#ffffff" />
            <rect x="4.9" y="3.15" width="0.7" height="0.7" fill="#ffffff" />
            <rect x="1.6" y="3.35" width="0.35" height="0.35" fill="#1c1c1c" />
            <rect x="5.1" y="3.35" width="0.35" height="0.35" fill="#1c1c1c" />
          </g>
        </svg>
      </div>

      <!-- Bee 2: sweeps the whole meadow, bloom to bloom -->
      <div class="bee bee-2 role-worker-2">
        <svg viewBox="0 -0.9 7 8" width="84" height="96">
          <g class="bee-wings">
            <rect x="1.1" y="-0.75" width="2" height="0.7" fill="#dff1ff" />
            <rect x="3.9" y="-0.75" width="2" height="0.7" fill="#dff1ff" />
          </g>
          <path class="bee-body" fill="#ff7bac" d="M0 0 H2 V1 H5 V0 H7 V1 H6 V2 H7 V6.75 H6 V6.2 H4 V7.1 H3 V6.2 H1 V6.75 H0 V2 H1 V1 H0 Z" />
          <g class="bee-eyes">
            <rect x="1.4" y="3.15" width="0.7" height="0.7" fill="#ffffff" />
            <rect x="4.9" y="3.15" width="0.7" height="0.7" fill="#ffffff" />
            <rect x="1.6" y="3.35" width="0.35" height="0.35" fill="#1c1c1c" />
            <rect x="5.1" y="3.35" width="0.35" height="0.35" fill="#1c1c1c" />
          </g>
        </svg>
      </div>

      <!-- Bee 3: shuttles between the last two flowers -->
      <div class="bee bee-3 role-worker-3">
        <svg viewBox="0 -0.9 7 8" width="46" height="53">
          <g class="bee-wings">
            <rect x="1.1" y="-0.75" width="2" height="0.7" fill="#dff1ff" />
            <rect x="3.9" y="-0.75" width="2" height="0.7" fill="#dff1ff" />
          </g>
          <path class="bee-body" fill="#55dd4a" d="M0 0 H2 V1 H5 V0 H7 V1 H6 V2 H7 V6.75 H6 V6.2 H4 V7.1 H3 V6.2 H1 V6.75 H0 V2 H1 V1 H0 Z" />
          <g class="bee-eyes">
            <rect x="1.4" y="3.15" width="0.7" height="0.7" fill="#ffffff" />
            <rect x="4.9" y="3.15" width="0.7" height="0.7" fill="#ffffff" />
            <rect x="1.6" y="3.35" width="0.35" height="0.35" fill="#1c1c1c" />
            <rect x="5.1" y="3.35" width="0.35" height="0.35" fill="#1c1c1c" />
          </g>
        </svg>
      </div>

    </div>

    <!-- Navigation Columns -->
    <div class="footer-nav-grid">
      <div class="footer-col">
        <h4 class="col-title">PRODUCT</h4>
        <ul class="col-links">
          {productLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title">RESOURCES</h4>
        <ul class="col-links">
          {resourcesLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title">COMPANY</h4>
        <ul class="col-links">
          {companyLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title">LEGAL</h4>
        <ul class="col-links">
          {legalLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <span class="copy-txt">© 2026 TAR. Built from Tamil with ❤️ for the world.</span>
      <div class="social-icons">
        <a href="https://x.com" aria-label="X" class="social-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://github.com" aria-label="GitHub" class="social-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-section {
    background-color: #1d2b20;
    color: var(--color-paper-white);
    padding: 0 0 40px;
    box-sizing: border-box;
  }

  .footer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* GET STARTED */
  .cta-row {
    display: flex;
    justify-content: center;
    padding: 72px 0 64px;
  }

  .get-started-btn {
    background: #ffffff;
    color: #14211a;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    padding: 16px 34px;
    border-radius: 999px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .get-started-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  /* Story caption */
  .bee-story {
    text-align: center;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 24px;
  }

  /* Bee environment scene */
  .bee-scene {
    position: relative;
    height: 190px;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .flower {
    position: absolute;
    bottom: -1px;
    transform-origin: bottom center;
    animation: flower-sway 4.5s ease-in-out infinite;
  }

  .f1 { left: 38%; animation-delay: 0s; }
  .f2 { left: 62%; animation-delay: 1.2s; }
  .f3 { left: 84%; animation-delay: 2.3s; }

  @keyframes flower-sway {
    0%, 100% { transform: rotate(0deg); }
    30% { transform: rotate(-2.5deg); }
    70% { transform: rotate(2.5deg); }
  }

  .bee {
    position: absolute;
    display: flex;
    animation: bee-bob 2.6s ease-in-out infinite;
  }

  /* WORKER 1 — the scout: patrols high above the meadow, watching the sky */
  .role-worker-1 {
    left: 8%;
    top: 18px;
    animation: scout-patrol 11s ease-in-out infinite;
  }

  @keyframes scout-patrol {
    0%, 100% { left: 8%; transform: scaleX(1); }
    42% { left: 30%; transform: scaleX(1); }
    50% { left: 30%; transform: scaleX(-1); }
    92% { left: 8%; transform: scaleX(-1); }
  }

  /* WORKER 2: sweeps the whole meadow low over the blooms, out and back */
  .role-worker-2 {
    left: 12%;
    bottom: 95px;
    animation: bee-bob 2.6s ease-in-out infinite, work-sweep 18s ease-in-out infinite;
  }

  @keyframes work-sweep {
    0%, 100% { left: 12%; transform: scaleX(1); }
    48% { left: 78%; transform: scaleX(1); }
    50% { left: 78%; transform: scaleX(-1); }
    98% { left: 12%; transform: scaleX(-1); }
  }

  /* WORKER 3: shuttles between the last two flower tops */
  .role-worker-3 {
    left: 60%;
    bottom: 86px;
    animation: bee-bob 2.2s ease-in-out infinite, work-shuttle 8s ease-in-out infinite;
  }

  @keyframes work-shuttle {
    0%, 100% { left: 60%; }
    20% { bottom: 104px; }
    40% { left: 81%; bottom: 80px; }
    60% { bottom: 102px; }
    80% { left: 60%; bottom: 86px; }
  }

  .bee-1 { animation-delay: 0s; }
  .bee-3 { animation-delay: 0.5s; }

  .bee-body {
    transform-origin: 3.5px 7.1px;
    animation: bee-sway 3.4s ease-in-out infinite;
  }

  .bee-1 .bee-body { animation-delay: 0.2s; }
  .bee-2 .bee-body { animation-delay: 0.9s; }
  .bee-3 .bee-body { animation-delay: 1.5s; }

  .bee-eyes {
    transform-origin: 3.5px 3.15px;
    transform-box: view-box;
    animation: bee-blink 4.2s ease-in-out infinite;
  }

  .bee-wings {
    transform-origin: 3.5px 0px;
    transform-box: view-box;
    animation: wing-flutter 0.22s ease-in-out infinite alternate;
  }

  @keyframes wing-flutter {
    from { transform: scaleY(1); }
    to { transform: scaleY(0.35); }
  }

  .bee-1 .bee-eyes { animation-delay: 1.1s; }
  .bee-2 .bee-eyes { animation-delay: 2.3s; }
  .bee-3 .bee-eyes { animation-delay: 3.4s; }

  @keyframes bee-bob {
    0%, 100% { margin-bottom: 0; }
    50% { margin-bottom: 7px; }
  }

  @keyframes bee-sway {
    0%, 100% { transform: rotate(0deg); }
    30% { transform: rotate(-2.4deg); }
    70% { transform: rotate(2.4deg); }
  }

  @keyframes bee-blink {
    0%, 91%, 97%, 100% { transform: scaleY(1); }
    94% { transform: scaleY(0.08); }
  }

  @media (max-width: 639px) {
    .bee-scene {
      height: 150px;
    }

    .f3 { display: none; }

    .role-worker-1 {
      left: 10%;
      top: 12px;
      animation: scout-patrol 11s ease-in-out infinite;
    }

    .role-worker-2 {
      left: 55%;
      bottom: 70px;
      animation: bee-bob 2.6s ease-in-out infinite;
    }

    .role-worker-3 {
      left: 66%;
      bottom: 60px;
      animation: bee-bob 2.2s ease-in-out infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bee, .bee-body, .bee-eyes, .bee-wings, .flower {
      animation: none;
    }
  }

  .bee svg {
    display: block;
  }

  @media (max-width: 639px) {
    .peek-row {
      gap: 32px;
    }

    .bee-3 {
      display: none;
    }
  }

  /* Navigation Columns */
  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    padding: 48px 0;
  }

  @media (min-width: 900px) {
    .footer-nav-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 48px;
    }
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 18px 0;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #ffffff;
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    padding-top: 24px;
  }

  @media (min-width: 640px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copy-txt {
    margin: 0;
  }

  .social-icons {
    display: flex;
    gap: 18px;
  }

  .social-link {
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.15s ease;
  }

  .social-link:hover {
    color: #ffffff;
  }
</style>
