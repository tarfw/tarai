---
// Support & Help Center Page for TAR
// Follows modern support standard (Buzz / Block model) tailored for TAR local-first platform
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import FooterSection from "../components/FooterSection.astro";

const sections = [
  { id: "overview", title: "1. Support Overview" },
  { id: "getting-started", title: "2. Getting Started & Setup" },
  { id: "interfaces", title: "3. Connecting Channels" },
  { id: "credits-billing", title: "4. Credits & Billing" },
  { id: "offline-sync", title: "5. Offline Work & Cloud Sync" },
  { id: "data-export", title: "6. Data Export & Portability" },
  { id: "faq", title: "7. Frequently Asked Questions" },
  { id: "contact-support", title: "8. Contact TAR Support" }
];
---

<Layout 
  title="Support & Help Center — TAR" 
  description="Learn how to use TAR, configure local-first workspaces, connect messaging channels, manage compute credits, and contact TAR Support."
>
  <Nav />

  <main class="support-main font-dm-sans">
    <div class="container support-layout-grid">
      
      <!-- Left: Sticky Minimal Sidebar Navigation -->
      <aside class="support-sidebar">
        <div class="sidebar-sticky-box">
          <span class="sidebar-label">HELP & SUPPORT</span>
          <nav class="sidebar-nav">
            {sections.map((s) => (
              <a href={`#${s.id}`} class="sidebar-link">{s.title}</a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Right: Support Content -->
      <div class="support-content-col">
        
        <!-- Header -->
        <header class="support-header">
          <div class="support-badge">Help Center</div>
          <h1 class="support-main-title">TAR Support</h1>
          <p class="support-main-lead">
            Guides, operational documentation, and direct assistance for running TAR local-first workspaces and AI agents.
          </p>
        </header>

        <hr class="support-divider" />

        <!-- 1. Support Overview -->
        <section id="overview" class="support-section">
          <h2 class="section-heading">1. Support Overview</h2>
          <p class="section-text">
            TAR is built on an offline-first architecture with transparent, at-cost AI operations. Most configurations can be managed directly on your phone or tablet without technical assistance.
          </p>
          <div class="support-cards-grid">
            <a href="/docs" class="support-quick-card">
              <strong>User Documentation →</strong>
              <p>Step-by-step guides for installing, configuring, and adding team staff.</p>
            </a>
            <a href="/agents" class="support-quick-card">
              <strong>Agent Capabilities & Rates →</strong>
              <p>What TAR agents can do, how they are bounded, and their at-cost rates.</p>
            </a>
          </div>
        </section>

        <hr class="support-divider" />

        <!-- 2. Getting Started & Setup -->
        <section id="getting-started" class="support-section">
          <h2 class="section-heading">2. Getting Started & Setup</h2>
          <p class="section-text">
            <strong>App Installation:</strong> Download the official TAR application directly from the Google Play Store on your Android phone, tablet, or store terminal.
          </p>
          <p class="section-text">
            <strong>Creating a Local Workspace:</strong> Open the app and tap <em>New Workspace</em>. Your local database is generated on-device with zero cloud server fees.
          </p>
          <p class="section-text">
            <strong>Inviting Staff (₹0 Per Seat):</strong> Invite cashiers, doctors, nurses, drivers, or volunteers by sending an invite link. Invited staff are 100% free with no per-seat software licenses.
          </p>
        </section>

        <hr class="support-divider" />

        <!-- 3. Connecting Channels -->
        <section id="interfaces" class="support-section">
          <h2 class="section-heading">3. Connecting Channels</h2>
          <p class="section-text">
            Connect your Workspace to customer communication channels:
          </p>
          <ul class="support-bullets">
            <li><strong>WhatsApp Business:</strong> Connect via Meta Cloud API or QR scan to automate appointment scheduling, catalog inquiries, and confirmations.</li>
            <li><strong>Telegram:</strong> Link your Telegram Bot token to enable group broadcasts, customer help queues, and field alerts.</li>
            <li><strong>Voice Notes (Whisper):</strong> Enable audio transcription to automatically turn spoken voice notes into structured orders and tasks.</li>
            <li><strong>Hosted Web Catalog:</strong> Enable 1-tap public web ordering links for your customers.</li>
          </ul>
        </section>

        <hr class="support-divider" />

        <!-- 4. Credits & Billing -->
        <section id="credits-billing" class="support-section">
          <h2 class="section-heading">4. Credits & Billing</h2>
          <p class="section-text">
            <strong>How Credits Work:</strong> 1 Credit = ₹0.10 (10 Paise). Credits pass through raw computational resources with zero profit markup on AI tokens.
          </p>
          <p class="section-text">
            <strong>Checking Balance & Logs:</strong> Open <em>Settings → Credit Wallet</em> in the app to view real-time balance and an itemized log of all automated actions.
          </p>
          <p class="section-text">
            <strong>Wallet Refills:</strong> Top up anytime via UPI, card, or net banking (Starter ₹100, Growth ₹500, Scale ₹1,000). Paid credits in active accounts do not expire.
          </p>
        </section>

        <hr class="support-divider" />

        <!-- 5. Offline Work & Cloud Sync -->
        <section id="offline-sync" class="support-section">
          <h2 class="section-heading">5. Offline Work & Cloud Sync</h2>
          <p class="section-text">
            <strong>Offline Operation:</strong> If your store or clinic loses internet connectivity, you can continue creating orders, billing customers, and viewing records. When reconnected, changes sync automatically.
          </p>
          <p class="section-text">
            <strong>Encrypted Multi-Device Sync:</strong> Enable cloud sync under <em>Workspace Settings</em> to replicate data securely across multiple phones or store terminals via TLS 1.3 encryption.
          </p>
          <p class="section-text">
            <strong>Device Revocation:</strong> If a device is lost or decommissioned, revoke it instantly from the Workspace switcher to invalidate local cryptographic keys.
          </p>
        </section>

        <hr class="support-divider" />

        <!-- 6. Data Export & Portability -->
        <section id="data-export" class="support-section">
          <h2 class="section-heading">6. Data Export & Portability</h2>
          <p class="section-text">
            <strong>1-Click Full Export:</strong> Open <em>Workspace Settings → Data Export</em> to download your complete database in open, standard formats (SQLite, JSON, and OKF Markdown files).
          </p>
          <p class="section-text">
            <strong>Workspace Deletion:</strong> Deleting a Workspace purges local hardware records immediately and wipes all associated encrypted cloud backups permanently.
          </p>
        </section>

        <hr class="support-divider" />

        <!-- 7. Frequently Asked Questions -->
        <section id="faq" class="support-section">
          <h2 class="section-heading">7. Frequently Asked Questions</h2>
          <div class="faq-list">
            <div class="faq-item">
              <strong>Do invited team members need to pay?</strong>
              <p>No. Invited staff, cashiers, or field workers are always ₹0.00. Operations consume credits from the Workspace owner's centralized wallet.</p>
            </div>
            <div class="faq-item">
              <strong>Are my private customer messages used to train AI models?</strong>
              <p>Never. AI inferences process messages ephemerally. Your customer conversations are never stored or used to train third-party models.</p>
            </div>
            <div class="faq-item">
              <strong>Can AI make mistakes with accounting or billing?</strong>
              <p>No. Under the TAR architecture, financial records and inventory balances are mathematically calculated and validated by deterministic Gateway code. AI only assists with drafting and language understanding.</p>
            </div>
          </div>
        </section>

        <hr class="support-divider" />

        <!-- 8. Contact TAR Support -->
        <section id="contact-support" class="support-section">
          <h2 class="section-heading">8. Contact TAR Support</h2>
          <p class="section-text">
            Our team is available to assist you with onboarding, technical integration, and account support:
          </p>
          <ul class="support-bullets">
            <li><strong>General & Technical Support:</strong> <a href="mailto:support@tarfw.com" class="support-link">support@tarfw.com</a></li>
            <li><strong>Billing & Credit Inquiries:</strong> <a href="mailto:billing@tarfw.com" class="support-link">billing@tarfw.com</a></li>
            <li><strong>Spam & Trust Reporting:</strong> <a href="mailto:abuse@tarfw.com" class="support-link">abuse@tarfw.com</a></li>
            <li><strong>Security Vulnerability Reports:</strong> <a href="mailto:security@tarfw.com" class="support-link">security@tarfw.com</a></li>
          </ul>
        </section>

      </div>
    </div>
  </main>

  <FooterSection />
</Layout>

<style>
  .support-main {
    background-color: #ffffff;
    color: var(--color-ink-black);
    min-height: 80vh;
    padding: 40px 0 80px 0;
  }

  .support-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .support-layout-grid {
      grid-template-columns: 220px 1fr;
      gap: 56px;
    }
  }

  /* Sticky Minimal Sidebar */
  .support-sidebar {
    display: none;
  }

  @media (min-width: 900px) {
    .support-sidebar {
      display: block;
    }
  }

  .sidebar-sticky-box {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-slate);
    text-transform: uppercase;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sidebar-link {
    font-size: 13.5px;
    color: var(--color-graphite);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .sidebar-link:hover {
    background-color: #f3f4f6;
    color: var(--color-canopy-green);
    font-weight: 600;
  }

  /* Main Content Column */
  .support-content-col {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .support-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .support-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-canopy-green);
    background-color: #ecfdf5;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .support-main-title {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    font-weight: 700;
    color: var(--color-canopy-green);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .support-main-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  .support-divider {
    border: none;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    margin: 0;
  }

  /* Sections */
  .support-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 88px;
  }

  .section-heading {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-canopy-green);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-graphite);
    margin: 0;
  }

  .section-text strong {
    color: var(--color-ink-black);
  }

  .support-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 4px;
  }

  @media (min-width: 600px) {
    .support-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .support-quick-card {
    padding: 16px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    background-color: #f9fafb;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .support-quick-card:hover {
    background-color: #f3f4f6;
    border-color: var(--color-canopy-green);
  }

  .support-quick-card strong {
    font-size: 14px;
    color: var(--color-canopy-green);
  }

  .support-quick-card p {
    font-size: 12.5px;
    color: var(--color-slate);
    line-height: 1.45;
    margin: 0;
  }

  .support-bullets {
    margin: 4px 0 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .support-bullets li {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .support-bullets strong {
    color: var(--color-ink-black);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background-color: #f9fafb;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 6px;
  }

  .faq-item strong {
    font-size: 14px;
    color: var(--color-ink-black);
  }

  .faq-item p {
    font-size: 13px;
    color: var(--color-graphite);
    line-height: 1.5;
    margin: 0;
  }

  .support-link {
    color: var(--color-canopy-green);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
