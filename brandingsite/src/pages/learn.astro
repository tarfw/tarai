<script>
  // Simple client-side filter for postcard deck
  const btnAll = document.getElementById('btn-all');
  const btnP1 = document.getElementById('btn-p1');
  const btnP2 = document.getElementById('btn-p2');
  const cards = document.querySelectorAll('.postcard-container');

  function setFilter(activeBtn, moduleFilter) {
    [btnAll, btnP1, btnP2].forEach(b => b?.classList.remove('active'));
    activeBtn?.classList.add('active');

    cards.forEach(card => {
      const cardModule = card.getAttribute('data-module');
      if (moduleFilter === 'all' || cardModule === moduleFilter) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  btnAll?.addEventListener('click', (e) => {
    e.preventDefault();
    setFilter(btnAll, 'all');
  });

  btnP1?.addEventListener('click', (e) => {
    e.preventDefault();
    setFilter(btnP1, '1');
  });

  btnP2?.addEventListener('click', (e) => {
    e.preventDefault();
    setFilter(btnP2, '2');
  });
</script>

