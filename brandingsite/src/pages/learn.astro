---
// TAR Learn — The AI Agent & Company Brain Illustrated Postcard Deck
// Comprehensive distillation of OpenAI's "A Practical Guide to Building AI Agents"
// and Slite's "Company Brain" organizational memory research.
// 12 Square Collector Postcards with zero AI slop, flat design system, and plain English.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import FooterSection from "../components/FooterSection.astro";
---

<Layout
  title="Illustrated Postcard Handbook — AI Agents & Company Brain | TAR"
  description="12 beautifully illustrated square postcards explaining autonomous AI agents and living company memory. Complete distillation of OpenAI's Agent Guide and Slite's Company Brain."
>
  <Nav />

  <main class="learn-page font-dm-sans">
    
    <!-- Hero Header -->
    <header class="learn-hero room-canopy-green">
      <div class="container hero-inner">
        <div class="badge-pill">TAR Illustrated Postcards • Complete 12-Card Guide</div>
        <h1 class="hero-title">
          The AI Agent & Company<br class="hidden-mobile" />
          Brain Postcard Handbook.
        </h1>
        <p class="hero-subtitle">
          A comprehensive visual guide distilling OpenAI's "A Practical Guide to Building AI Agents" and Slite's "Company Brain" research into 12 square illustrated collector postcards. Built for teams of all technical levels.
        </p>

        <!-- Filter Pill Controls -->
        <div class="deck-filter-bar">
          <button class="filter-pill active" id="btn-all">All 12 Postcards</button>
          <button class="filter-pill" id="btn-p1">Part 1: OpenAI Agent Guide (01–06)</button>
          <button class="filter-pill" id="btn-p2">Part 2: Slite Company Brain (07–12)</button>
        </div>
      </div>
    </header>

    <!-- Postcard Gallery Grid Container -->
    <section class="postcard-gallery-section" id="gallery">
      <div class="container">
        
        <!-- Postcards Grid (Square 1:1 Aspect Ratio Cards) -->
        <div class="postcards-grid">
          
          <!-- ============================================== -->
          <!-- POSTCARD 01: Chatbots vs Agents + 3 Triad      -->
          <!-- ============================================== -->
          <article class="postcard-container card-sage" data-module="1">
            <div class="postcard-frame">
              <div class="postcard-header">
                <div class="postcard-num-stamp">
                  <span class="stamp-pill">CARD 01 / 12</span>
                  <span class="stamp-module">PART 1: OPENAI AGENT GUIDE</span>
                </div>
                <span class="stamp-topic">Agent Anatomy</span>
              </div>

              <div class="postcard-illustration-box">
                <svg viewBox="0 0 400 210" class="postcard-svg" aria-hidden="true">
                  <!-- The 3 Core Components of an Agent -->
                  <g transform="translate(15, 15)">
                    <rect width="115" height="85" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <circle cx="57" cy="22" r="12" fill="#d2f2e3" />
                    <text x="57" y="26" text-anchor="middle" font-size="9" font-weight="800" fill="#0a3922">1</text>
                    <text x="57" y="48" text-anchor="middle" font-size="9.5" font-weight="700" fill="#0a3922">MODEL</text>
                    <text x="57" y="62" text-anchor="middle" font-size="7.5" fill="#64748b">LLM reasoning</text>
                    <text x="57" y="74" text-anchor="middle" font-size="7.5" fill="#64748b">& decision logic</text>
                  </g>

                  <g transform="translate(142, 15)">
                    <rect width="115" height="85" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <circle cx="57" cy="22" r="12" fill="#eee2ff" />
                    <text x="57" y="26" text-anchor="middle" font-size="9" font-weight="800" fill="#460095">2</text>
                    <text x="57" y="48" text-anchor="middle" font-size="9.5" font-weight="700" fill="#0a3922">TOOLS</text>
                    <text x="57" y="62" text-anchor="middle" font-size="7.5" fill="#64748b">APIs, SQLite DB,</text>
                    <text x="57" y="74" text-anchor="middle" font-size="7.5" fill="#64748b">& math formulas</text>
                  </g>

                  <g transform="translate(270, 15)">
                    <rect width="115" height="85" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <circle cx="57" cy="22" r="12" fill="#ccf0f8" />
                    <text x="57" y="26" text-anchor="middle" font-size="9" font-weight="800" fill="#003642">3</text>
                    <text x="57" y="48" text-anchor="middle" font-size="9.5" font-weight="700" fill="#0a3922">INSTRUCTIONS</text>
                    <text x="57" y="62" text-anchor="middle" font-size="7.5" fill="#64748b">System prompt,</text>
                    <text x="57" y="74" text-anchor="middle" font-size="7.5" fill="#64748b">rules & boundaries</text>
                  </g>

                  <!-- Agent vs Chatbot Comparison Bar -->
                  <g transform="translate(15, 112)">
                    <rect width="180" height="82" rx="10" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5" />
                    <text x="90" y="20" text-anchor="middle" font-size="8.5" font-weight="700" fill="#64748b">PASSIVE CHATBOT</text>
                    <text x="14" y="40" font-size="7.5" fill="#475569">• In: Text prompt from user</text>
                    <text x="14" y="54" font-size="7.5" fill="#475569">• Out: Conversational text only</text>
                    <text x="14" y="68" font-size="7.5" font-weight="600" fill="#b91c1c">• Zero real-world execution</text>
                  </g>

                  <g transform="translate(205, 112)">
                    <rect width="180" height="82" rx="10" fill="#0a3922" stroke="#0a3922" stroke-width="1.5" />
                    <text x="90" y="20" text-anchor="middle" font-size="8.5" font-weight="700" fill="#55dd4a">AUTONOMOUS AGENT</text>
                    <text x="14" y="40" font-size="7.5" fill="#ffffff">• In: Operational business goal</text>
                    <text x="14" y="54" font-size="7.5" fill="#d2f2e3">• Out: Multi-step tool executions</text>
                    <text x="14" y="68" font-size="7.5" font-weight="700" fill="#55dd4a">• Updates DB & verifies completion</text>
                  </g>
                </svg>
              </div>

              <div class="postcard-body">
                <h2 class="postcard-title">Chatbots Talk. Agents Execute.</h2>
                <p class="postcard-desc">
                  OpenAI defines an agent as a system where an LLM dynamically directs workflow execution using three core pillars: <strong>Model</strong> (reasoning engine), <strong>Tools</strong> (external capabilities), and <strong>Instructions</strong> (operational guardrails).
                </p>
              </div>

              <div class="postcard-footer">
                <div class="scenario-box">
                  <span class="scenario-tag">EVERYDAY SCENARIO</span>
                  <p class="scenario-text">A chatbot quotes doctor clinic hours from a text file. An agent queries SQLite, checks doctor rosters, reschedules 14 patient slots, and sends WhatsApp confirmations.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- ============================================== -->
          <!-- POSTCARD 02: The Run Loop & Self-Correction    -->
          <!-- ============================================== -->
          <article class="postcard-container card-mint" data-module="1">
            <div class="postcard-frame">
              <div class="postcard-header">
                <div class="postcard-num-stamp">
                  <span class="stamp-pill">CARD 02 / 12</span>
                  <span class="stamp-module">PART 1: OPENAI AGENT GUIDE</span>
                </div>
                <span class="stamp-topic">The Run Loop</span>
              </div>

              <div class="postcard-illustration-box">
                <svg viewBox="0 0 400 210" class="postcard-svg" aria-hidden="true">
                  <!-- 4 Step Loop -->
                  <g transform="translate(25, 20)">
                    <rect width="160" height="70" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <circle cx="20" cy="22" r="10" fill="#d2f2e3" />
                    <text x="20" y="26" text-anchor="middle" font-size="10" font-weight="800" fill="#0a3922">1</text>
                    <text x="38" y="24" font-size="11" font-weight="700" fill="#0a3922">OBSERVE</text>
                    <text x="14" y="46" font-size="8.5" fill="#475569">Ingests voice notes, bills, or</text>
                    <text x="14" y="58" font-size="8.5" fill="#475569">incoming customer WhatsApp.</text>
                  </g>

                  <path d="M190 55 H210" stroke="#0a3922" stroke-width="2" />
                  <polygon points="210,55 204,51 204,59" fill="#0a3922" />

                  <g transform="translate(215, 20)">
                    <rect width="160" height="70" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <circle cx="20" cy="22" r="10" fill="#eee2ff" />
                    <text x="20" y="26" text-anchor="middle" font-size="10" font-weight="800" fill="#460095">2</text>
                    <text x="38" y="24" font-size="11" font-weight="700" fill="#0a3922">PLAN STEPS</text>
                    <text x="14" y="46" font-size="8.5" fill="#475569">Breaks goal into ordered</text>
                    <text x="14" y="58" font-size="8.5" fill="#475569">sequence of tool operations.</text>
                  </g>

                  <path d="M295 95 V115" stroke="#0a3922" stroke-width="2" />
                  <polygon points="295,115 291,109 299,109" fill="#0a3922" />

                  <g transform="translate(215, 120)">
                    <rect width="160" height="70" rx="10" fill="#0a3922" />
                    <circle cx="20" cy="22" r="10" fill="#55dd4a" />
                    <text x="20" y="26" text-anchor="middle" font-size="10" font-weight="800" fill="#0a3922">3</text>
                    <text x="38" y="24" font-size="11" font-weight="700" fill="#ffffff">ACT / TOOLS</text>
                    <text x="14" y="46" font-size="8.5" fill="#d2f2e3">Executes deterministic API,</text>
                    <text x="14" y="58" font-size="8.5" fill="#d2f2e3">database query, or ledger write.</text>
                  </g>

                  <path d="M210 155 H190" stroke="#0a3922" stroke-width="2" />
                  <polygon points="190,155 196,151 196,159" fill="#0a3922" />

                  <g transform="translate(25, 120)">
                    <rect width="160" height="70" rx="10" fill="#ffffff" stroke="#1dbf73" stroke-width="2" />
                    <circle cx="20" cy="22" r="10" fill="#d2f2e3" />
                    <text x="20" y="26" text-anchor="middle" font-size="10" font-weight="800" fill="#0a3922">4</text>
                    <text x="38" y="24" font-size="11" font-weight="700" fill="#0a3922">VERIFY / RECOVER</text>
                    <text x="14" y="46" font-size="8.5" fill="#475569">Checks exit conditions. If an</text>
                    <text x="14" y="58" font-size="8.5" fill="#475569">error occurs, self-corrects.</text>
                  </g>

                  <path d="M105 115 V95" stroke="#1dbf73" stroke-width="1.5" stroke-dasharray="3" />
                </svg>
              </div>

              <div class="postcard-body">
                <h2 class="postcard-title">Observe → Plan → Act → Verify</h2>
                <p class="postcard-desc">
                  OpenAI's central execution engine is the <strong>Run Loop</strong>. The agent runs iteratively: inspecting context, planning tools, executing calls, and evaluating results until reaching a verified exit condition or safe human escalation.
                </p>
              </div>

              <div class="postcard-footer">
                <div class="scenario-box">
                  <span class="scenario-tag">EVERYDAY SCENARIO</span>
                  <p class="scenario-text">1. Listen to Tamil voice note → 2. Extract 4 medicine items → 3. Deduct stock in SQLite and draft invoice → 4. Verify calculation before sending UPI link.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- ============================================== -->
          <!-- POSTCARD 03: Orchestration Topologies          -->
          <!-- ============================================== -->
          <article class="postcard-container card-lavender" data-module="1">
            <div class="postcard-frame">
              <div class="postcard-header">
                <div class="postcard-num-stamp">
                  <span class="stamp-pill">CARD 03 / 12</span>
                  <span class="stamp-module">PART 1: OPENAI AGENT GUIDE</span>
                </div>
                <span class="stamp-topic">Orchestration Patterns</span>
              </div>

              <div class="postcard-illustration-box">
                <svg viewBox="0 0 400 210" class="postcard-svg" aria-hidden="true">
                  <!-- Pattern 1: Single Specialist -->
                  <g transform="translate(10, 20)">
                    <rect width="115" height="170" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <text x="57" y="24" text-anchor="middle" font-size="8.5" font-weight="700" fill="#0a3922">1. SPECIALIST</text>
                    <circle cx="57" cy="55" r="16" fill="#d2f2e3" />
                    <text x="57" y="59" text-anchor="middle" font-size="8" font-weight="800" fill="#0a3922">POS</text>
                    <path d="M57 75 V95" stroke="#0a3922" stroke-width="1.5" />
                    <rect x="12" y="100" width="91" height="30" rx="4" fill="#0a3922" />
                    <text x="57" y="118" text-anchor="middle" font-size="8" font-weight="700" fill="#ffffff">Checkout Tool</text>
                    <text x="57" y="150" text-anchor="middle" font-size="7" fill="#64748b">Single task focus</text>
                    <text x="57" y="160" text-anchor="middle" font-size="7" fill="#64748b">Lowest complexity</text>
                  </g>

                  <!-- Pattern 2: Router / Triage -->
                  <g transform="translate(135, 20)">
                    <rect width="125" height="170" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <text x="62" y="24" text-anchor="middle" font-size="8.5" font-weight="700" fill="#0a3922">2. ROUTER / TRIAGE</text>
                    <rect x="18" y="38" width="89" height="24" rx="4" fill="#0a3922" />
                    <text x="62" y="53" text-anchor="middle" font-size="8" font-weight="700" fill="#55dd4a">Router Agent</text>
                    
                    <path d="M62 64 V78 M35 78 H90 M35 78 V88 M90 78 V88" stroke="#0a3922" stroke-width="1.2" />
                    <rect x="12" y="90" width="46" height="24" rx="4" fill="#f1f5f9" stroke="#cbd5e1" />
                    <text x="35" y="104" text-anchor="middle" font-size="7" font-weight="600" fill="#0a3922">Billing</text>
                    <rect x="67" y="90" width="46" height="24" rx="4" fill="#f1f5f9" stroke="#cbd5e1" />
                    <text x="90" y="104" text-anchor="middle" font-size="7" font-weight="600" fill="#0a3922">Support</text>
                    
                    <text x="62" y="150" text-anchor="middle" font-size="7" fill="#64748b">Routes by intent</text>
                    <text x="62" y="160" text-anchor="middle" font-size="7" fill="#64748b">Modularity</text>
                  </g>

                  <!-- Pattern 3: Manager-Worker Swarm -->
                  <g transform="translate(270, 20)">
                    <rect width="120" height="170" rx="10" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <text x="60" y="24" text-anchor="middle" font-size="8.5" font-weight="700" fill="#0a3922">3. MANAGER SWARM</text>
                    <circle cx="60" cy="48" r="14" fill="#0a3922" />
                    <text x="60" y="52" text-anchor="middle" font-size="7" font-weight="800" fill="#55dd4a">Lead</text>

                    <path d="M60 64 V78 M25 78 H95 M25 78 V88 M60 78 V88 M95 78 V88" stroke="#0a3922" stroke-width="1.2" />
                    <circle cx="25" cy="100" r="9" fill="#eee2ff" />
                    <text x="25" y="103" text-anchor="middle" font-size="6" font-weight="700" fill="#460095">OCR</text>
                    <circle cx="60" cy="100" r="9" fill="#ccf0f8" />
                    <text x="60" y="103" text-anchor="middle" font-size="6" font-weight="700" fill="#003642">Tax</text>
                    <circle cx="95" cy="100" r="9" fill="#ffede8" />
                    <text x="95" y="103" text-anchor="middle" font-size="6" font-weight="700" fill="#47264c">PDF</text>

                    <text x="60" y="150" text-anchor="middle" font-size="7" fill="#64748b">Parallel delegation</text>
                    <text x="60" y="160" text-anchor="middle" font-size="7" fill="#64748b">& data synthesis</text>
                  </g>
                </svg>
              </div>

              <div class="postcard-body">
                <h2 class="postcard-title">Specialists, Routers & Swarms</h2>
                <p class="postcard-desc">
                  OpenAI emphasizes three architectural topologies: start with a focused <strong>Single Specialist</strong>; use a <strong>Router Agent</strong> when handling multi-intent triage; and use <strong>Manager-Worker Swarms</strong> for complex parallel synthesis.
                </p>
              </div>

              <div class="postcard-footer">
                <div class="scenario-box">
                  <span class="scenario-tag">EVERYDAY SCENARIO</span>
                  <p class="scenario-text">An inbound WhatsApp message is triaged by the Router: voice receipts are delegated to Groq Whisper OCR; stock requests to SQLite; and high-value orders to the store manager.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- ============================================== -->
          <!-- POSTCARD 04: Deterministic Tools & Schemas     -->
          <!-- ============================================== -->
          <article class="postcard-container card-sky" data-module="1">
            <div class="postcard-frame">
              <div class="postcard-header">
                <div class="postcard-num-stamp">
                  <span class="stamp-pill">CARD 04 / 12</span>
                  <span class="stamp-module">PART 1: OPENAI AGENT GUIDE</span>
                </div>
                <span class="stamp-topic">Deterministic Tools</span>
              </div>

              <div class="postcard-illustration-box">
                <svg viewBox="0 0 400 210" class="postcard-svg" aria-hidden="true">
                  <!-- Probabilistic Guessing -->
                  <g transform="translate(15, 20)">
                    <rect width="170" height="170" rx="12" fill="#fff1f2" stroke="#f43f5e" stroke-width="1.5" />
                    <text x="85" y="24" text-anchor="middle" font-size="8.5" font-weight="700" fill="#be123c">PROBABILISTIC TEXT GUESSING</text>
                    
                    <rect x="14" y="40" width="142" height="34" rx="6" fill="#ffffff" stroke="#fecdd3" />
                    <text x="20" y="56" font-size="8.5" fill="#475569">AI computes math in text:</text>
                    <text x="20" y="68" font-size="8" fill="#94a3b8">"₹140 x 30 + 18% is ~₹4,900"</text>
                    
                    <circle cx="85" cy="110" r="16" fill="#fee2e2" />
                    <text x="85" y="115" text-anchor="middle" font-size="14" font-weight="800" fill="#be123c">✗</text>
                    
                    <text x="85" y="146" text-anchor="middle" font-size="8.5" font-weight="700" fill="#be123c">Hallucinated Rounding Error</text>
                    <text x="85" y="158" text-anchor="middle" font-size="7.5" fill="#64748b">Mismatched tax ledger balances</text>
                  </g>

                  <!-- Typed Deterministic Tool -->
                  <g transform="translate(215, 20)">
                    <rect width="170" height="170" rx="12" fill="#ecfdf5" stroke="#0a3922" stroke-width="2" />
                    <text x="85" y="24" text-anchor="middle" font-size="8.5" font-weight="700" fill="#0a3922">TYPED DETERMINISTIC TOOL</text>
                    
                    <rect x="14" y="40" width="142" height="52" rx="6" fill="#0a3922" />
                    <text x="20" y="55" font-size="7.5" font-weight="700" fill="#55dd4a">tool: calculate_invoice()</text>
                    <text x="20" y="68" font-size="7.5" fill="#ffffff">qty: 30 • unit_price: 140.00</text>
                    <text x="20" y="80" font-size="7.5" fill="#d2f2e3">gst_rate: 0.18</text>
                    
                    <circle cx="85" cy="115" r="14" fill="#55dd4a" />
                    <text x="85" y="119" text-anchor="middle" font-size="12" font-weight="800" fill="#0a3922">✓</text>
                    
                    <text x="85" y="146" text-anchor="middle" font-size="9" font-weight="800" fill="#0a3922">₹4,956.00 Exact</text>
                    <text x="85" y="158" text-anchor="middle" font-size="7.5" fill="#64748b">100% precision every execution</text>
                  </g>
                </svg>
              </div>

              <div class="postcard-body">
                <h2 class="postcard-title">Exact Math via Typed Tools</h2>
                <p class="postcard-desc">
                  LLMs are word predictors unsuited for raw accounting. OpenAI's guide mandates calling <strong>deterministic tools</strong> with strict JSON schemas, delegating mathematics and database mutations to verified code.
                </p>
              </div>

              <div class="postcard-footer">
                <div class="scenario-box">
                  <span class="scenario-tag">EVERYDAY SCENARIO</span>
                  <p class="scenario-text">When billing a ₹14,500 wholesale order, the agent runs the typed arithmetic tool: ₹14,500 + 18% GST = ₹17,110.00. Zero calculation hallucinations.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- ============================================== -->
          <!-- POSTCARD 05: Guardrails & Human-in-the-Loop    -->
          <!-- ============================================== -->
          <article class="postcard-container card-peach" data-module="1">
            <div class="postcard-frame">
              <div class="postcard-header">
                <div class="postcard-num-stamp">
                  <span class="stamp-pill">CARD 05 / 12</span>
                  <span class="stamp-module">PART 1: OPENAI AGENT GUIDE</span>
                </div>
                <span class="stamp-topic">Guardrails & Safety</span>
              </div>

              <div class="postcard-illustration-box">
                <svg viewBox="0 0 400 210" class="postcard-svg" aria-hidden="true">
                  <!-- Low Risk Routine Funnel -->
                  <g transform="translate(30, 25)">
                    <rect width="100" height="60" rx="8" fill="#ffffff" stroke="#0a3922" stroke-width="1.5" />
                    <text x="50" y="24" text-anchor="middle" font-size="9" font-weight="700" fill="#0a3922">Routine Action</text>
                    <text x="50" y="38" text-anchor="middle" font-size="7.5" fill="#64748b">Catalog check or</text>
                    <text x="50" y="48" text-anchor="middle" font-size="7.5" fill="#64748b">standard order</text>
                  </g>

                  <path d="M135 55 H175" stroke="#0a3922" stroke-width="2" />
                  <rect x="180" y="40" width="190" height="32" rx="6" fill="#ecfdf5" stroke="#1dbf73" />
                  <circle cx="196" cy="56" r="6" fill="#1dbf73" />
                  <text x="285" y="60" text-anchor="middle" font-size="9" font-weight="700" fill="#0a3922">Autonomous Execution (Instant)</text>

                  <!-- High Risk HITL Funnel -->
                  <g transform="translate(30, 115)">
                    <rect width="100" height="60" rx="8" fill="#fff1f2" stroke="#dc2626" stroke-width="1.5" />
                    <text x="50" y="24" text-anchor="middle" font-size="9" font-weight="700" fill="#dc2626">High-Stakes Action</text>
                    <text x="50" y="38" text-anchor="middle" font-size="7.5" fill="#64748b">Refund > ₹2,000 or</text>
                    <text x="50" y="48" text-anchor="middle" font-size="7.5" fill="#64748b">prescription change</text>
                  </g>

                  <path d="M135 145 H175" stroke="#dc2626" stroke-width="2" />
                  <rect x="180" y="125" width="190" height="42" rx="8" fill="#ffffff" stroke="#dc2626" stroke-width="2" />
                  <circle cx="198" cy="146" r="8" fill="#fee2e2" />
                  <text x="198" y="150" text-anchor="middle" font-size="9" font-weight="800" fill="#dc2626">!</text>
                  <text x="285" y="142" text-anchor="middle" font-size="9" font-weight="700" fill="#dc2626">1-Tap Human Approval Gate</text>
                  <text x="285" y="156" text-anchor="middle" font-size="7.5" fill="#64748b">Drafts proposal in team feed</text>
                </svg>
              </div>

              <div class="postcard-body">
                <h2 class="postcard-title">Guardrails & Human-in-the-Loop</h2>
                <p class="postcard-desc">
                  OpenAI mandates strict guardrails: input validation, circuit breakers, and <strong>Human-in-the-Loop (HITL)</strong> approval gates. Low-risk queries execute autonomously; high-risk actions pause for 1-tap human signoff.
                </p>
              </div>

              <div class="postcard-footer">
                <div class="scenario-box">
                  <span class="scenario-tag">EVERYDAY SCENARIO</span>
