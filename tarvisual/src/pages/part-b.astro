---
import DeckLayout from '../layouts/DeckLayout.astro';
import IconSprite from '../components/IconSprite.astro';
import B0Screens from '../components/screens/B0Screens.astro';
import B1Screens from '../components/screens/B1Screens.astro';
import B2Screens from '../components/screens/B2Screens.astro';
import B3Screens from '../components/screens/B3Screens.astro';
import B4Screens from '../components/screens/B4Screens.astro';
import B5Screens from '../components/screens/B5Screens.astro';
import B6Screens from '../components/screens/B6Screens.astro';
import B7Screens from '../components/screens/B7Screens.astro';
import B8Screens from '../components/screens/B8Screens.astro';
import B9Screens from '../components/screens/B9Screens.astro';
import '../styles/part-b.css';
---

<DeckLayout
  title="TAR v4 — Part B concept screens"
  description="Twenty-six concept screens for TAR v4: setup, canvas, card, flow, checkout, store site, business manager and inbox."
>
  <IconSprite />
  <div class="app">
    <aside class="rail">
      <a class="brand" href="/"><b>TAR</b><span>v4</span><small>part b · screens</small></a>
      <nav class="nav" id="bNav" aria-label="Part B groups">
        <button class="nav-item is-active" data-group="b0"><span class="n">B0</span><span class="nl">Setup</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b1"><span class="n">B1</span><span class="nl">Owner</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b2"><span class="n">B2</span><span class="nl">Staff</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b3"><span class="n">B3</span><span class="nl">Card</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b4"><span class="n">B4</span><span class="nl">Flow</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b5"><span class="n">B5</span><span class="nl">Checkout</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b6"><span class="n">B6</span><span class="nl">Details</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b7"><span class="n">B7</span><span class="nl">Web</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b8"><span class="n">B8</span><span class="nl">Manager</span><span class="nd"></span></button>
        <button class="nav-item" data-group="b9"><span class="n">B9</span><span class="nl">Inbox</span><span class="nd"></span></button>
      </nav>
      <div class="rail-bottom">
        <div class="rail-lanes">
          <div class="lane-pill"><i class="l"></i> B0–B6 · phone</div>
          <div class="lane-pill"><i class="j"></i> B7 · web</div>
          <div class="lane-pill"><i class="c"></i> B8–B9 · phone</div>
        </div>
        <div class="rail-arrows">
          <button class="arrow-btn" id="bPrev" aria-label="Previous screen"><svg class="ico" style="transform:rotate(180deg)"><use href="#i-arrow"/></svg></button>
          <button class="arrow-btn" id="bNext" aria-label="Next screen"><svg class="ico"><use href="#i-arrow"/></svg></button>
        </div>
      </div>
    </aside>

    <main class="stage">
      <header class="top">
        <div>
          <div class="kicker" id="bKicker">Part B / B0 · Setup</div>
          <h1 id="bTitle">Three screens to a working Canvas.</h1>
        </div>
        <div class="top-side">
          <div class="no-model"><span class="pulse"></span> 26 concept screens</div>
          <a class="cross-link" href="/"><span>←</span> Part A</a>
        </div>
      </header>

      <div class="b-intro">
        <p id="bIntroText">A description becomes a workspace. Jev proposes the cards; the owner confirms. Every screen is a read or one commit.</p>
        <div class="b-pattern">title + ≤2 live metrics + one primary tap</div>
      </div>

      <div class="b-work" id="bWork" data-kind="phone">
        <aside class="b-index panel" aria-label="Screens in this group">
          <div class="b-index-head"><span>Screens</span><b id="bIndexCount">3</b></div>
          <div class="b-index-list" id="bIndexList"></div>
        </aside>

        <div class="b-stage">
          <div class="b-scenes" id="bScenes">
            <B0Screens />
            <B1Screens />
            <B2Screens />
            <B3Screens />
            <B4Screens />
            <B5Screens />
            <B6Screens />
            <B7Screens />
            <B8Screens />
            <B9Screens />
          </div>
        </div>

        <aside class="b-notes panel" id="bNotes" aria-live="polite"></aside>
      </div>

      <footer class="footer">
        <span>TAR v4 · part b · concept screens</span>
        <span>every screen is a read or one commit</span>
      </footer>
    </main>
  </div>
</DeckLayout>

<script>
  import '../scripts/part-b.js';
</script>
