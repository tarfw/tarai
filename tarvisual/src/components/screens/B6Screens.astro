    <div class="bp-phone">
      <div class="bp-screen">
        <div class="bp-status"><span>9:41</span><span>94%</span></div>
        <div class="bp-head">
          <div class="bp-head-row"><span class="bp-back">‹ Back</span><b class="bp-head-title">Add Product</b><span class="bp-action">Done</span></div>
