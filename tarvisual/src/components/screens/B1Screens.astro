<section
  class="b-scene"
  data-screen="b1"
  data-group="b1"
  data-kind="phone"
  data-n="01"
  data-label="Owner"
  data-code="B1"
  data-name="Canvas — owner"
  data-who="Owner"
  data-tap="Any card, or the next action"
  data-commit="one record per tap"
  data-note="The owner sees six cards: an alert on top, the next action, then the stack. Same Canvas for every role, filtered by grants."
>
  <div class="b-device">
    <div class="bp-phone bp-phone-tall">
      <div class="bp-screen">
        <div class="bp-status"><span>9:41</span><span>94%</span></div>
        <div class="bp-head">
          <div class="bp-head-row"><b>Aambal Neyvagam</b><span class="bp-role">Owner</span></div>
          <div class="bp-sub">Full access · 6 cards</div>
        </div>
        <div class="bp-body bp-body-tight">
          <div class="bp-alert">
            <svg class="ico"><use href="#i-alert"/></svg>
            <div><b>Cash drawer out by ₹350</b><small>Shift 14 · tap to audit</small></div>
            <span class="chev">›</span>
          </div>

          <div class="bp-next">
            <div><div class="bp-card-title">Next · dispatch</div><small>Order 42 · due 15m</small></div>
            <span class="bp-next-action">Complete</span>
          </div>

          <div class="bp-card">
            <div class="bp-card-head"><span class="bp-card-title">Counter Sales</span><span class="bp-tag money">Shift 14</span></div>
            <div class="bp-metrics">
              <div class="bp-metric"><b>₹18,450</b><span>today</span></div>
              <div class="bp-metric"><b>₹14,100</b><span>UPI</span></div>
            </div>
            <div class="bp-flow-note">14 bills · drawer cash ₹4,350</div>
            <button class="bp-card-action">New Counter Sale</button>
          </div>

          <div class="bp-card">
            <div class="bp-card-head"><span class="bp-card-title">Orders and Fulfilment</span><span class="bp-tag customer">3 pending</span></div>
            <div class="bp-metrics">
              <div class="bp-metric"><b>3</b><span>pending</span></div>
              <div class="bp-metric"><b>11</b><span>dispatched</span></div>
            </div>
            <div class="bp-flow-note">Next: garment for Senthamizh · Courier</div>
            <button class="bp-card-action">Open Queue</button>
          </div>

          <div class="bp-card">
            <div class="bp-card-head"><span class="bp-card-title">Online Store</span><span class="bp-tag live">Live</span></div>
            <div class="bp-flow-note">aambal.tar.site</div>
            <div class="bp-metrics">
              <div class="bp-metric"><b>142</b><span>visits today</span></div>
              <div class="bp-metric"><b>8</b><span>WhatsApp</span></div>
            </div>
            <button class="bp-card-action">View Store</button>
          </div>

          <div class="bp-card">
            <div class="bp-card-head"><span class="bp-card-title">Shop Closing Routine</span><span class="bp-tag none">Step 2 / 4</span></div>
            <div class="bp-flow-note">Count cash · Kanimozhi</div>
            <div class="bp-progress"><i style="--w:50%"></i></div>
            <button class="bp-card-action">Resume</button>
          </div>

          <button class="bp-add-card">+ Add a Card</button>
        </div>
        <div class="bp-composer"><span>Message TAR...</span><b>+</b></div>
        <div class="bp-tabbar">
          <span class="on"><i></i>Canvas</span>
          <span><i></i>Flows</span>
          <span><i></i>Site</span>
          <span><i></i>You</span>
        </div>
      </div>
    </div>
  </div>
</section>
