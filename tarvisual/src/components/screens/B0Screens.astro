<section
  class="b-scene is-active"
  data-screen="b0-1"
  data-group="b0"
  data-kind="phone"
  data-n="01"
  data-label="Create"
  data-code="B0.1"
  data-name="Create a workspace"
  data-who="Owner"
  data-tap="Generate Workspace and Canvas"
  data-commit="workspace + canvas + grants"
  data-note="A name and a description are enough. Jev places the first cards; nothing is committed until the owner taps."
>
  <div class="b-device">
    <div class="bp-phone">
      <div class="bp-screen">
        <div class="bp-status"><span>9:41</span><span>94%</span></div>
        <div class="bp-head">
          <div class="bp-head-row"><b>New Workspace</b><span class="bp-action">Cancel</span></div>
        </div>
        <div class="bp-body">
          <div class="bp-field-label">Name your workspace</div>
          <div class="bp-input">Aambal Neyvagam</div>
          <div class="bp-field-label">What do you make and sell?</div>
          <div class="bp-input bp-input-area">Weave silk and cotton textiles, UPI and cash counter, ship nationwide, need an online store.</div>
          <div class="bp-jev-note">
            <svg class="ico"><use href="#i-hex"/></svg>
            <span>Jev will place the right cards on your Canvas.</span>
          </div>
          <button class="bp-primary">Generate Workspace and Canvas</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="b-scene"
  data-screen="b0-2"
  data-group="b0"
  data-kind="phone"
  data-n="02"
  data-label="Review"
  data-code="B0.2"
  data-name="Review the cards Jev selected"
  data-who="Owner"
  data-tap="Confirm and Open Canvas"
  data-commit="canvas layout"
  data-note="Five cards are proposed from the description. The owner can tap any card to start; more can be added later."
>
  <div class="b-device">
    <div class="bp-phone">
      <div class="bp-screen">
        <div class="bp-status"><span>9:41</span><span>94%</span></div>
        <div class="bp-head">
          <div class="bp-head-row"><span class="bp-back">‹ Back</span><b class="bp-head-title">Your Shop Canvas</b><span class="bp-action">Ready</span></div>
        </div>
        <div class="bp-body">
          <div class="bp-kicker">Aambal Neyvagam · Salem</div>
          <div class="bp-title">Handloom and Apparel</div>
          <div class="bp-chip-row">
            <span class="bp-chip accent">95% match</span>
            <span class="bp-chip">5 cards selected</span>
          </div>
          <div class="bp-section-head"><span>Jev selected 5 cards</span><b>5 / 5</b></div>
          <div class="bp-checklist">
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Counter Sales</span><span class="meta">money</span></div>
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Orders and Dispatch</span><span class="meta">customer</span></div>
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Products and Prices</span><span class="meta">data</span></div>
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Online Storefront</span><span class="meta">customer</span></div>
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Shop Checklists</span><span class="meta">flow</span></div>
          </div>
          <div class="bp-note">Tap a card to start. More later via + Add Card.</div>
          <button class="bp-primary">Confirm and Open Canvas</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="b-scene"
  data-screen="b0-3"
  data-group="b0"
  data-kind="phone"
  data-n="03"
  data-label="Invite"
  data-code="B0.3"
  data-name="Add a member and their cards"
  data-who="Owner"
  data-tap="Save and Send Invitation"
  data-commit="member + grants"
  data-note="The role is inferred from the words. The owner can still choose which cards the member can see."
>
  <div class="b-device">
    <div class="bp-phone">
      <div class="bp-screen">
        <div class="bp-status"><span>9:41</span><span>94%</span></div>
        <div class="bp-head">
          <div class="bp-head-row"><span class="bp-back">‹ Back</span><b class="bp-head-title">Add Team Member</b><span class="bp-action">Done</span></div>
        </div>
        <div class="bp-body">
          <div class="bp-sub">Workspace · Aambal Neyvagam</div>
          <div class="bp-field-label">Phone or email</div>
          <div class="bp-input">kanimozhi@aambal.in</div>
          <div class="bp-field-label">What will this person do?</div>
          <div class="bp-input bp-input-area">Counter cashier. Handles sales, counts the drawer, packs orders. Does not edit prices.</div>
          <div class="bp-section-head"><span>Cards Kanimozhi can see</span><b>3 / 5</b></div>
          <div class="bp-checklist">
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Counter Sales</span><span class="meta">visible</span></div>
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Cash Drawer</span><span class="meta">visible</span></div>
            <div class="bp-check-row"><span class="bp-check on">✓</span><span>Orders and Dispatch</span><span class="meta">visible</span></div>
            <div class="bp-check-row"><span class="bp-check"></span><span>Products and Prices</span><span class="meta">hidden</span></div>
            <div class="bp-check-row"><span class="bp-check"></span><span>Online Storefront</span><span class="meta">hidden</span></div>
          </div>
          <div class="bp-jev-note">
            <svg class="ico"><use href="#i-hex"/></svg>
            <span>Jev assigned: Member (Cashier).</span>
          </div>
          <button class="bp-primary">Save and Send Invitation</button>
        </div>
      </div>
    </div>
  </div>
</section>
