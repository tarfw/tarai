<section
  class="b-scene"
  data-screen="b4"
  data-group="b4"
  data-kind="phone"
  data-n="01"
  data-label="Flow"
  data-code="B4"
  data-name="A flow run"
  data-who="Assignee"
  data-tap="Perform Step 2"
