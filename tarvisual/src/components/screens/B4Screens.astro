  data-note="Done, now, waiting. One primary tap advances the run. The flow is a card that knows its next step."
>
  <div class="b-device">
    <div class="bp-phone">
      <div class="bp-screen">
        <div class="bp-status"><span>9:41</span><span>94%</span></div>
        <div class="bp-head">
          <div class="bp-head-row"><span class="bp-back">‹ Back</span><b class="bp-head-title">Evening Closing</b><span class="bp-action">Close</span></div>
        </div>
        <div class="bp-body">
          <div class="bp-progress-head">
            <div><b>Step 2 of 4</b><div class="bp-sub">Owner · Kanimozhi</div></div>
            <span>50%</span>
          </div>
          <div class="bp-progress"><i style="--w:50%"></i></div>

          <div class="bp-flow-steps">
            <div class="bp-flow-step done"><span class="mark">✓</span><span>Save invoices</span><span class="state">done</span></div>
            <div class="bp-flow-step now"><span class="mark">›</span><span>Count cash drawer</span><span class="state">now</span></div>
            <div class="bp-flow-step waiting"><span class="mark"></span><span>Send closing summary</span><span class="state">waiting</span></div>
            <div class="bp-flow-step waiting"><span class="mark"></span><span>Lock register</span><span class="state">waiting</span></div>
          </div>

          <div class="bp-note">One primary tap advances the run. Every step writes one record.</div>
          <button class="bp-primary">Perform Step 2</button>
        </div>
      </div>
    </div>
